// =============================================================================
// Sistema de gestión multipanel — capa de datos
//
// Reglas de diseño (ver también prisma/migrations/*_constraints/migration.sql):
// - Dinero: Decimal(12,2). Cantidades: Int. IDs: cuid().
// - Soft delete (deletedAt) en entidades maestras. Nunca DELETE físico de negocio.
// - Stock es un caché del ledger MovimientoStock: solo cambia en la misma
//   transacción que inserta un movimiento (lo garantizan triggers en la DB).
// - MovimientoStock y AuditLog son inmutables (triggers bloquean UPDATE/DELETE).
// - Las restricciones que Prisma no sabe expresar (CHECK, índices únicos
//   parciales, triggers, vistas) viven en la migración "constraints".
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  // relationJoins: `include` se resuelve con JOINs en UNA query (buscarPorCodigo
  // lo usa con relationLoadStrategy: "join"; sin esto Prisma hace 1 query por relación).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  /// App: en producción, el pooler (PgBouncer / Neon pooler, modo transaction) con connection_limit.
  url       = env("DATABASE_URL")
  /// Migraciones: conexión directa (sin pooler) con el usuario de migraciones.
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum RolUsuario {
  OWNER
  EMPLEADO
}

/// Por panel: DASHBOARD..REPORTES (PermisoUsuario con panelId).
/// Globales (solo OWNER, sin filas de permiso): USUARIOS, CONFIGURACION.
enum Modulo {
  DASHBOARD
  PROVEEDORES
  PRODUCTOS
  STOCK
  VENTAS
  CLIENTES
  DEVOLUCIONES
  COMPRAS
  COTIZADOR
  REPORTES
  /// Cuenta corriente: crear = vender fiado, ver = ver deudas, editar = registrar cobros.
  FIADOS
  /// Comisiones del pasista por compra (ver = ver el acumulado; marcar pagadas: solo dueños).
  PASISTA
  /// Facturas (paneles con facturación): ver, crear (emitir/registrar), editar (PDF y número externo).
  FACTURAS
  /// «Escanea Charly»: ver las ventas con escaneo remoto pedido y confirmar su escaneo.
  ESCANEO
  USUARIOS
  CONFIGURACION
}

enum TipoMovimiento {
  INGRESO_COMPRA
  INGRESO_MANUAL
  VENTA
  /// Histórico (anulación de ventas antes de R3). Nuevas anulaciones: VENTA_ANULADA.
  DEVOLUCION_CLIENTE
  DEVOLUCION_PROVEEDOR
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  /// Egreso: la unidad nueva que se le entrega al cliente por una falla (garantía).
  GARANTIA
  /// Ingreso: se anuló una devolución por garantía.
  GARANTIA_ANULADA
  /// Ingreso: se anuló una venta (vuelve la mercadería).
  VENTA_ANULADA
}

/// «Escanea Charly»: verificación física de una venta de un galpón con escaneo remoto.
enum Escaneo {
  /// Pedido: la venta espera que la escanee el usuario de escaneo.
  PENDIENTE
  /// Todo lo vendido coincidió con lo escaneado: lista para retirar.
  ESCANEADA
}

enum EstadoVenta {
  CONFIRMADA
  ANULADA
}

enum TipoVenta {
  UNITARIA
  MAYORISTA
}

enum TipoCotizacion {
  UNITARIA
  MAYORISTA
}

/// Monedas con cotización automática (pesos por unidad): USDT (proveedores) y dólar blue (mayorista).
enum MonedaCambio {
  USDT
  USD_BLUE
}

/// Punta de la cotización de cambio. VENTA = lo que cuesta comprar la moneda (la que se usa para convertir).
/// (No es TipoCotizacion: ese nombre ya lo usa el cotizador para UNITARIA/MAYORISTA.)
enum TipoCotizacionCambio {
  COMPRA
  VENTA
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
  CONVERTIDA
}

enum EstadoDevolucion {
  REGISTRADA
  ANULADA
}

enum EstadoCompra {
  BORRADOR
  RECIBIDA
  ANULADA
}

enum EstadoTransferencia {
  PENDIENTE
  COMPLETADA
  ANULADA
}

/// Moneda del precio de un proveedor. Los proveedores cotizan en USDT; el
/// equivalente en pesos sale de la cotización USDT vigente (cambio.service).
enum Moneda {
  ARS
  USDT
}

/// Los medios que ofrece cada panel (y su orden) salen de su configuración de
/// ventas ("ventas".mediosPago); el enum es la lista de todos los posibles.
enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  BINANCE
  MERCADO_LIBRE
}

/// De dónde salió el precio cobrado de un ítem de venta.
/// LISTA: precio de venta del sabor. ML: precio Mercado Libre (venta cobrada por
/// Mercado Libre). ESPECIAL: precio manual del vendedor. COTIZACION: el de la
/// cotización que se convirtió en la venta.
enum OrigenPrecio {
  LISTA
  ML
  ESPECIAL
  COTIZACION
}

/// A, B y C: facturas AFIP emitidas por fuera del sistema (se registran con su
/// número externo). COMPROBANTE_INTERNO: lo genera el sistema, no es válido como factura.
enum TipoFactura {
  A
  B
  C
  COMPROBANTE_INTERNO
}

enum EstadoFactura {
  EMITIDA
  ANULADA
}

enum CondicionIva {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
}

/// PAGADA: montoPagado = total. PARCIAL: pagó algo y debe el resto. PENDIENTE: fiado total.
enum EstadoPago {
  PAGADA
  PARCIAL
  PENDIENTE
}

enum AccionAuditoria {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PERMISO_CAMBIADO
  /// Intento de hacer algo sin permiso (Forbidden).
  ACCESO_DENEGADO
  SESION_REVOCADA
}

// -----------------------------------------------------------------------------
// Usuarios y permisos
// -----------------------------------------------------------------------------

model Usuario {
  id                   String     @id @default(cuid())
  nombre               String
  /// Siempre en minúsculas (CHECK en DB + toLowerCase() en Zod).
  email                String     @unique
  passwordHash         String
  rol                  RolUsuario
  activo               Boolean    @default(true)
  /// true => al iniciar sesión se lo obliga a ir a /cuenta a cambiarla.
  debeCambiarPassword  Boolean    @default(false)
  ultimoLogin          DateTime?
  /// Comisión orientativa (solo referencia en el dashboard; null = no se muestra).
  comisionUnitariaPct  Decimal?   @db.Decimal(5, 2)
  comisionMayoristaPct Decimal?   @db.Decimal(5, 2)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?

  permisos               PermisoUsuario[]
  paneles                UsuarioPanel[]
  movimientos            MovimientoStock[]
  compras                Compra[]
  ventas                 Venta[]                  @relation("VentaUsuario")
  ventasAnuladas         Venta[]                  @relation("VentaAnuladaPor")
  transferencias         Transferencia[]
  auditLogs              AuditLog[]
  devoluciones           Devolucion[]             @relation("DevolucionUsuario")
  devolucionesAnuladas   Devolucion[]             @relation("DevolucionAnuladaPor")
  pagosVenta             PagoVenta[]              @relation("PagoVentaUsuario")
  pagosVentaAnulados     PagoVenta[]              @relation("PagoVentaAnuladoPor")
  facturas               Factura[]                @relation("FacturaUsuario")
  facturasAnuladas       Factura[]                @relation("FacturaAnuladaPor")
  cotizaciones           Cotizacion[]             @relation("CotizacionVendedor")
  preciosProveedor       ProveedorProducto[]
  gastosCompra           GastoCompra[]            @relation("GastoCompraUsuario")
  gastosCompraAnulados   GastoCompra[]            @relation("GastoCompraAnuladoPor")
  cambiosCosto           CostoVarianteHistorial[]
  comisionesPagadas      ComisionPasista[]
  sesiones               Sesion[]                 @relation("SesionUsuario")
  codigosVerificacion    CodigoVerificacion[]
  sesionesRevocadas      Sesion[]                 @relation("SesionRevocadaPor")
  clientesCreados        Cliente[]                @relation("ClienteCreadoPor")
  tarifasVendedor        TarifaVendedor[]         @relation("TarifaVendedorUsuario")
  tarifasActualizadas    TarifaVendedor[]         @relation("TarifaVendedorActualizadaPor")
  liquidaciones          LiquidacionVendedor[]    @relation("LiquidacionVendedor")
  liquidacionesGeneradas LiquidacionVendedor[]    @relation("LiquidacionGeneradaPor")
  liquidacionesPagadas   LiquidacionVendedor[]    @relation("LiquidacionPagadaPor")
  firmasRemito           FirmaRemito[]            @relation("FirmaRemitoUsuario")
  enviosRemito           EnvioRemito[]            @relation("EnvioRemitoUsuario")
  escaneosPedidos        Venta[]                  @relation("VentaEscaneoPedidoPor")
  ventasEscaneadas       Venta[]                  @relation("VentaEscaneadaPor")
  facturasML             FacturaMercadoLibre[]
}

/// Sesión de login (el JWT lleva su id como `sid`). Revocarla corta el acceso
/// en el próximo request (el middleware la consulta con caché de 60 s).
model Sesion {
  id            String    @id @default(cuid())
  usuarioId     String
  /// sha256 del secreto aleatorio que viaja en el JWT (`tok`): un sid solo no alcanza.
  tokenHash     String
  userAgent     String?
  ip            String?
  createdAt     DateTime  @default(now())
  ultimoUso     DateTime  @default(now())
  expiraAt      DateTime
  revocadaAt    DateTime?
  revocadaPorId String?

  usuario     Usuario  @relation("SesionUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  revocadaPor Usuario? @relation("SesionRevocadaPor", fields: [revocadaPorId], references: [id], onDelete: SetNull)

  codigosVerificacion CodigoVerificacion[]

  @@index([usuarioId, revocadaAt])
  @@index([expiraAt])
}

enum PropositoCodigo {
  /// Cambio de la propia contraseña desde «Mi cuenta».
  CAMBIO_PASSWORD
}

/// Código de 6 dígitos mandado por mail al usuario logueado (cambio de
/// contraseña). Solo se guarda su HMAC (pepper = AUTH_SECRET); vence a los
/// 10 minutos, admite 5 intentos y se usa una sola vez. Al validarlo se emite
/// un token de verificación de corta vida ligado al usuario Y a la sesión que
/// lo pidió (`tokenHash`), que habilita el paso «contraseña nueva».
model CodigoVerificacion {
  id           String          @id @default(cuid())
  usuarioId    String
  /// Sesión que lo pidió: el código y el token solo valen desde ella.
  sesionId     String
  proposito    PropositoCodigo
  /// HMAC-SHA256(AUTH_SECRET, proposito:usuarioId:codigo), hex.
  codigoHash   String
  venceAt      DateTime
  intentos     Int             @default(0)
  /// Código validado (un solo uso) o anulado por uno nuevo.
  usadoAt      DateTime?
  /// HMAC del token de verificación emitido al validar el código.
  tokenHash    String?
  tokenVenceAt DateTime?
  /// Token consumido: la contraseña ya se cambió.
  tokenUsadoAt DateTime?
  createdAt    DateTime        @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sesion  Sesion  @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@index([usuarioId, proposito, createdAt])
  @@index([venceAt])
}

/// Registro de cada backup (pg_dump) y su verificación.
model Backup {
  id         String   @id @default(cuid())
  /// Clave en el bucket de backups (backups/backup-YYYY-MM-DD-HHmm.dump).
  archivo    String
  tamanio    BigInt?
  duracionMs Int
  ok         Boolean
  error      String?
  /// "cron" | "manual" | "release"
  origen     String   @default("cron")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Rate limit con ventana deslizante aproximada (ventanas de 1 minuto).
model RateLimit {
  clave    String
  ventana  DateTime
  contador Int      @default(0)

  @@id([clave, ventana])
  @@index([ventana])
}

/// Registro de intentos de login para rate limit (persistente: sobrevive a
/// redeploys y funciona con múltiples instancias, a diferencia de memoria).
model IntentoLogin {
  id        String   @id @default(cuid())
  /// Normalizado (trim + minúsculas). No es FK: se registran emails inexistentes.
  email     String
  ip        String?
  exitoso   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

/// Permisos de un EMPLEADO por panel y módulo. Los OWNER tienen acceso total
/// por rol y no necesitan filas acá (ni en UsuarioPanel).
model PermisoUsuario {
  id            String   @id @default(cuid())
  usuarioId     String
  panelId       String
  modulo        Modulo
  puedeVer      Boolean  @default(false)
  puedeCrear    Boolean  @default(false)
  puedeEditar   Boolean  @default(false)
  puedeEliminar Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  panel   Panel   @relation(fields: [panelId], references: [id], onDelete: Restrict)

  @@unique([usuarioId, panelId, modulo])
  @@index([panelId])
}

/// Paneles a los que accede un EMPLEADO (los OWNER acceden a todos sin filas).
model UsuarioPanel {
  id        String   @id @default(cuid())
  usuarioId String
  panelId   String
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  panel   Panel   @relation(fields: [panelId], references: [id], onDelete: Restrict)

  @@unique([usuarioId, panelId])
  @@index([panelId])
}

// -----------------------------------------------------------------------------
// Paneles: sistemas independientes dentro de la app (Vapes, Cosmetic, ...).
// Toda tabla de negocio tiene panelId; los servicios la consultan SOLO con
// dbPara(panelId) (src/server/db/panel-scoped.ts). La DB además verifica que
// cada fila apunte a filas de su mismo panel (trigger fn_verificar_mismo_panel)
// y que panelId no cambie nunca.
//
// panelId tiene DEFAULT current_setting('app.panel_id'): nadie la setea, así
// que un INSERT que olvide el panel falla por NOT NULL en vez de guardar datos
// huérfanos (y, de paso, Prisma lo tipa como opcional: lo inyecta dbPara).
// -----------------------------------------------------------------------------

model Panel {
  id                     String   @id @default(cuid())
  nombre                 String   @unique
  /// kebab-case: /p/{slug}. El prefijo del ID de venta sale de acá (VAP-000001).
  slug                   String   @unique
  logoUrl                String?
  /// Hex (#RRGGBB): tiñe botón primario e ítems activos dentro del panel.
  colorAcento            String?
  /// Cómo llama el panel al atributo principal de sus productos ("Pitadas", "Contenido"...).
  etiquetaEspecificacion String
  /// Cómo se llaman las unidades vendidas en el dashboard ("Vapes vendidos" en Vapes).
  etiquetaUnidades       String   @default("Unidades vendidas")
  orden                  Int      @default(0)
  activo                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  usuarios                  UsuarioPanel[]
  permisos                  PermisoUsuario[]
  depositos                 Deposito[]
  categorias                Categoria[]
  marcas                    Marca[]
  proveedores               Proveedor[]
  proveedorProductos        ProveedorProducto[]
  clientes                  Cliente[]
  productos                 Producto[]
  variantes                 Variante[]
  codigosAlternativos       CodigoBarrasAlternativo[]
  stocks                    Stock[]
  movimientos               MovimientoStock[]
  compras                   Compra[]
  compraItems               CompraItem[]
  ventas                    Venta[]
  ventaItems                VentaItem[]
  devoluciones              Devolucion[]
  devolucionItems           DevolucionItem[]
  escalones                 EscalonPrecio[]
  escalonesDefault          EscalonPrecioDefault[]
  historialPreciosProveedor ProveedorProductoHistorial[]
  cotizaciones              Cotizacion[]
  facturas                  Factura[]
  facturaItems              FacturaItem[]
  facturasML                FacturaMercadoLibre[]
  cotizacionItems           CotizacionItem[]
  transferencias            Transferencia[]
  transferenciaItems        TransferenciaItem[]
  pagosVenta                PagoVenta[]
  configuraciones           Configuracion[]
  gastosCompra              GastoCompra[]
  historialCostos           CostoVarianteHistorial[]
  comisionesPasista         ComisionPasista[]
  tarifasVendedor           TarifaVendedor[]
  liquidacionesVendedor     LiquidacionVendedor[]
  firmasRemito              FirmaRemito[]
  enviosRemito              EnvioRemito[]
  secuencias                Secuencia[]
  auditLogs                 AuditLog[]

  @@index([activo, orden])
}

/// Numeración correlativa por panel y entidad ("VENTA", "COMPRA", "TRANSFERENCIA",
/// "DEVOLUCION"). Se toma con SELECT ... FOR UPDATE dentro de la transacción.
model Secuencia {
  id           String   @id @default(cuid())
  panelId      String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  entidad      String
  ultimoNumero Int      @default(0)
  updatedAt    DateTime @updatedAt

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Restrict)

  @@unique([panelId, entidad])
}

// -----------------------------------------------------------------------------
// Maestros (por panel)
// -----------------------------------------------------------------------------

model Deposito {
  id            String   @id @default(cuid())
  panelId       String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  nombre        String
  direccion     String?
  activo        Boolean  @default(true)
  /// Un solo depósito principal por panel (índice único parcial en SQL).
  esPrincipal   Boolean  @default(false)
  /// Admite «Escanea Charly»: sus ventas pueden pedir el escaneo remoto (Vapes: Mercedes).
  escaneoRemoto Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  panel                 Panel             @relation(fields: [panelId], references: [id], onDelete: Restrict)
  stocks                Stock[]
  movimientos           MovimientoStock[]
  compras               Compra[]
  ventas                Venta[]
  transferenciasOrigen  Transferencia[]   @relation("TransferenciaOrigen")
  transferenciasDestino Transferencia[]   @relation("TransferenciaDestino")
  devoluciones          Devolucion[]

  @@unique([panelId, nombre])
}

model Categoria {
  id          String   @id @default(cuid())
  panelId     String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  panel     Panel      @relation(fields: [panelId], references: [id], onDelete: Restrict)
  productos Producto[]

  @@unique([panelId, nombre])
}

model Marca {
  id        String   @id @default(cuid())
  panelId   String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  panel     Panel      @relation(fields: [panelId], references: [id], onDelete: Restrict)
  productos Producto[]

  @@unique([panelId, nombre])
}

model Proveedor {
  id           String    @id @default(cuid())
  panelId      String    @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  /// Persona de contacto.
  nombre       String
  /// Normalizado ("+54" + dígitos). Único por panel entre proveedores no borrados (índice parcial en SQL).
  telefono     String?
  nombreTienda String
  notas        String?
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  panel            Panel                        @relation(fields: [panelId], references: [id], onDelete: Restrict)
  compras          Compra[]
  productos        ProveedorProducto[]
  historialPrecios ProveedorProductoHistorial[]

  @@index([panelId, nombre])
  @@index([panelId, nombreTienda])
}

/// Qué vende cada proveedor y a cuánto (precio de compra unitario por
/// producto, sin importar el sabor). Se pisa al editarlo y al recibir una
/// compra con "actualizar precio del proveedor".
model ProveedorProducto {
  id            String   @id @default(cuid())
  panelId       String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  proveedorId   String
  productoId    String
  precio        Decimal  @db.Decimal(12, 2)
  moneda        Moneda   @default(USDT)
  actualizadoAt DateTime @default(now())
  /// Quién fijó el precio vigente.
  usuarioId     String
  createdAt     DateTime @default(now())

  panel     Panel                        @relation(fields: [panelId], references: [id], onDelete: Restrict)
  proveedor Proveedor                    @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  producto  Producto                     @relation(fields: [productoId], references: [id], onDelete: Restrict)
  usuario   Usuario                      @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  historial ProveedorProductoHistorial[]

  @@unique([panelId, proveedorId, productoId])
  /// Comparador de precios: proveedores de un producto, de menor a mayor.
  @@index([panelId, productoId, precio])
}

model Cliente {
  id              String    @id @default(cuid())
  panelId         String    @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  nombre          String
  /// Obligatorio, normalizado "+54" + dígitos. Único por panel entre clientes no
  /// borrados (índice único parcial en SQL + CHECK de formato).
  telefono        String
  notas           String?
  /// Caché de Σ saldoPendiente de sus ventas confirmadas: solo cambia en la
  /// transacción de la venta fiada, del cobro o de la anulación (CHECK >= 0).
  saldoDeudor     Decimal   @default(0) @db.Decimal(12, 2)
  activo          Boolean   @default(true)
  /// Quién lo dio de alta (null en los cargados por seed o importación sin rastro).
  creadoPorId     String?
  /// La venta en la que se dio de alta (null si se cargó desde Clientes o el cotizador).
  creadoEnVentaId String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  panel         Panel        @relation(fields: [panelId], references: [id], onDelete: Restrict)
  creadoPor     Usuario?     @relation("ClienteCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEnVenta Venta?       @relation("ClienteCreadoEnVenta", fields: [creadoEnVentaId], references: [id], onDelete: Restrict)
  ventas        Venta[]
  devoluciones  Devolucion[]
  cotizaciones  Cotizacion[]
  facturas      Factura[]

  @@index([panelId, nombre])
  @@index([panelId, saldoDeudor])
  @@index([panelId, creadoPorId, createdAt])
  @@index([nombre(ops: raw("gin_trgm_ops"))], type: Gin, map: "cliente_nombre_trgm")
  @@index([telefono(ops: raw("gin_trgm_ops"))], type: Gin, map: "cliente_telefono_trgm")
}

// -----------------------------------------------------------------------------
// Catálogo
// -----------------------------------------------------------------------------

/// Producto = marca + modelo + especificación ("Elf Bar" + "BC" + "5000").
/// Todo producto tiene variantes (sabores); uno sin sabor tiene una sola
/// variante "Único" que la UI no muestra como tal.
model Producto {
  id                 String    @id @default(cuid())
  panelId            String    @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  marcaId            String
  /// El modelo (ej. "BC").
  nombre             String
  /// El atributo principal del panel (Panel.etiquetaEspecificacion): "5000" pitadas en Vapes.
  especificacion     String    @default("")
  /// Mantenido por trigger: lower(especificacion) sin espacios. Compara "mismo producto".
  especificacionNorm String    @default("")
  /// Mantenido por trigger: "{Marca} {Modelo} {Especificación}" (búsquedas y toda la UI).
  nombreCompleto     String    @default("")
  categoriaId        String?
  /// Precio unitario de venta de todos sus sabores (salvo los que tienen precio propio).
  precioVenta        Decimal   @db.Decimal(12, 2)
  /// Precio de venta por Mercado Libre de todos sus sabores (null = no se vende por ML).
  precioVentaML      Decimal?  @db.Decimal(12, 2)
  imagenUrl          String?
  activo             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  panel                     Panel                        @relation(fields: [panelId], references: [id], onDelete: Restrict)
  categoria                 Categoria?                   @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  marca                     Marca                        @relation(fields: [marcaId], references: [id], onDelete: Restrict)
  variantes                 Variante[]
  proveedores               ProveedorProducto[]
  compraItems               CompraItem[]
  ventaItems                VentaItem[]
  devolucionItems           DevolucionItem[]             @relation("DevolucionItemDevuelto")
  devolucionItemsEntregados DevolucionItem[]             @relation("DevolucionItemEntregado")
  escalones                 EscalonPrecio[]
  cotizacionItems           CotizacionItem[]
  transferenciaItems        TransferenciaItem[]
  historialPreciosProveedor ProveedorProductoHistorial[]

  @@unique([panelId, marcaId, nombre, especificacionNorm])
  @@index([panelId, categoriaId])
  @@index([panelId, marcaId])
  /// Trigram (pg_trgm) para búsquedas ILIKE '%texto%'.
  @@index([nombreCompleto(ops: raw("gin_trgm_ops"))], type: Gin, map: "producto_nombre_completo_trgm")
}

/// Variante = sabor de un producto. El stock es por variante y depósito.
model Variante {
  id            String    @id @default(cuid())
  /// Desnormalizado (= Producto.panelId, lo verifica un trigger): buscar por
  /// código de barras dentro de un panel no necesita join.
  panelId       String    @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  productoId    String
  /// El sabor ("Mango Ice"). "Único" para productos sin sabor.
  nombre        String
  /// Formato PRD-XXXXXX si no se provee. Único por panel.
  sku           String
  /// Único por panel (junto con CodigoBarrasAlternativo.codigo) entre variantes no borradas.
  codigoBarras  String?
  /// null = usa Producto.precioVenta. Solo para un sabor con precio distinto.
  precioVenta   Decimal?  @db.Decimal(12, 2)
  /// null = usa Producto.precioVentaML. Precio Mercado Libre propio del sabor.
  precioVentaML Decimal?  @db.Decimal(12, 2)
  /// Costo de la última compra recibida (snapshot que toma cada venta).
  ultimoCosto   Decimal?  @db.Decimal(12, 2)
  stockMinimo   Int       @default(0)
  activo        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  panel                     Panel                     @relation(fields: [panelId], references: [id], onDelete: Restrict)
  producto                  Producto                  @relation(fields: [productoId], references: [id], onDelete: Restrict)
  codigosAlternativos       CodigoBarrasAlternativo[]
  stocks                    Stock[]
  movimientos               MovimientoStock[]
  compraItems               CompraItem[]
  ventaItems                VentaItem[]
  devolucionItems           DevolucionItem[]          @relation("DevolucionItemDevuelto")
  devolucionItemsEntregados DevolucionItem[]          @relation("DevolucionItemEntregado")
  cotizacionItems           CotizacionItem[]
  transferenciaItems        TransferenciaItem[]
  historialCostos           CostoVarianteHistorial[]
  facturaItems              FacturaItem[]

  @@unique([panelId, sku])
  @@unique([panelId, productoId, nombre])
  /// Trigram (pg_trgm) para búsquedas ILIKE '%texto%'.
  @@index([nombre(ops: raw("gin_trgm_ops"))], type: Gin, map: "variante_nombre_trgm")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "variante_sku_trgm")
}

/// Un mismo producto puede venir con más de un código según lote/importador.
model CodigoBarrasAlternativo {
  id          String   @id @default(cuid())
  panelId     String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  varianteId  String
  codigo      String
  descripcion String?
  createdAt   DateTime @default(now())

  panel    Panel    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)

  @@unique([panelId, codigo])
  @@index([varianteId])
}

// -----------------------------------------------------------------------------
// Inventario
// -----------------------------------------------------------------------------

/// Caché del ledger. NUNCA se actualiza directo: solo vía registrarMovimiento().
/// Un trigger rechaza cualquier cambio de cantidad sin movimiento en la misma tx.
model Stock {
  id         String   @id @default(cuid())
  panelId    String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  varianteId String
  depositoId String
  cantidad   Int      @default(0)
  updatedAt  DateTime @updatedAt

  panel    Panel    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  deposito Deposito @relation(fields: [depositoId], references: [id], onDelete: Restrict)

  @@unique([panelId, varianteId, depositoId])
  @@index([panelId, depositoId])
}

/// Ledger INMUTABLE. Sin updatedAt. Los errores se corrigen con AJUSTE inverso.
model MovimientoStock {
  id             String         @id @default(cuid())
  panelId        String         @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  tipo           TipoMovimiento
  varianteId     String
  depositoId     String
  /// Siempre > 0: el signo lo define el tipo.
  cantidad       Int
  stockAnterior  Int
  stockPosterior Int
  costoUnitario  Decimal?       @db.Decimal(12, 2)
  motivo         String?
  /// "VENTA" | "COMPRA" | "TRANSFERENCIA" | "AJUSTE" | "DEVOLUCION" (CHECK en DB).
  referenciaTipo String?
  referenciaId   String?
  usuarioId      String
  createdAt      DateTime       @default(now())

  panel    Panel    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  deposito Deposito @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([panelId, varianteId, depositoId, createdAt])
  @@index([panelId, createdAt])
  @@index([panelId, depositoId, createdAt])
  @@index([referenciaTipo, referenciaId])
  @@index([usuarioId])
}

// -----------------------------------------------------------------------------
// Compras
// -----------------------------------------------------------------------------

model Compra {
  id             String       @id @default(cuid())
  panelId        String       @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  /// Correlativo por panel (tabla Secuencia).
  numero         Int
  proveedorId    String?
  /// Depósito donde ingresa la mercadería.
  depositoId     String
  fecha          DateTime     @default(now())
  estado         EstadoCompra @default(BORRADOR)
  subtotal       Decimal      @db.Decimal(12, 2)
  descuento      Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)
  notas          String?
  /// Snapshot de la cotización USDT (pesos por USDT) al cargar la compra: con
  /// ella se pasaron a pesos los precios en USDT del proveedor.
  tipoCambioUSDT Decimal?     @db.Decimal(14, 2)

  // --- Costos finales (compra.service: calcularCostosFinales / recalcularCostosFinales) ---
  /// % de comisión del pasista sobre (subtotal − descuento). null = sin comisión.
  comisionPasistaPorcentaje  Decimal? @db.Decimal(5, 2)
  /// = ROUND(total × % / 100, 2) (CHECK en la DB); 0 sin comisión.
  comisionPasistaMonto       Decimal  @default(0) @db.Decimal(12, 2)
  /// Σ GastoCompra no anulados (lo verifica un trigger diferido).
  gastosExtrasTotal          Decimal  @default(0) @db.Decimal(12, 2)
  /// = total + comisión + gastos (CHECK): lo que costó la mercadería "puesta en el galpón".
  costoFinalTotal            Decimal  @default(0) @db.Decimal(12, 2)
  /// Σ CompraItem.cantidad (trigger diferido).
  unidadesTotal              Int      @default(0)
  /// costoFinalTotal ÷ unidadesTotal, redondeado a centavos.
  costoUnitarioFinalPromedio Decimal  @default(0) @db.Decimal(12, 2)

  usuarioId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  panel             Panel                    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  proveedor         Proveedor?               @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  deposito          Deposito                 @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  usuario           Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  items             CompraItem[]
  gastos            GastoCompra[]
  costos            CostoVarianteHistorial[]
  comisionesPasista ComisionPasista[]

  @@unique([panelId, numero])
  @@index([panelId, fecha])
  @@index([panelId, proveedorId])
  @@index([panelId, depositoId])
  @@index([usuarioId])
}

/// Se compra por sabor (el stock es por sabor); productoId desnormalizado
/// (= variante.productoId, lo verifica un trigger) para precios por proveedor.
model CompraItem {
  id                 String   @id @default(cuid())
  panelId            String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  compraId           String
  varianteId         String
  productoId         String
  cantidad           Int
  /// En pesos: es lo que contabiliza el sistema (stock, ganancia).
  costoUnitario      Decimal  @db.Decimal(12, 2)
  /// Trazabilidad: el costo en USDT (costoUnitario ÷ Compra.tipoCambioUSDT)
  /// cuando el proveedor cotiza ese producto en USDT.
  costoUnitarioUSDT  Decimal? @db.Decimal(12, 2)
  subtotal           Decimal  @db.Decimal(12, 2)
  /// costoUnitario + (comisión del pasista + gastos extras) ÷ unidades de la compra:
  /// el costo real "puesto en el galpón" (el que pasa a Variante.ultimoCosto).
  /// Es lo único de un ítem que cambia en una compra recibida (al cargar gastos).
  costoUnitarioFinal Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  panel    Panel    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  compra   Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([compraId, varianteId])
  @@index([panelId, varianteId])
  @@index([panelId, productoId])
}

/// Gasto extra de una compra (valija, envío, flete…): suma al costo final y se
/// prorratea por unidad. No se edita ni se borra: se anula (trigger).
model GastoCompra {
  id              String    @id @default(cuid())
  panelId         String    @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  compraId        String
  motivo          String
  /// > 0 (CHECK).
  monto           Decimal   @db.Decimal(12, 2)
  fecha           DateTime  @default(now())
  usuarioId       String
  createdAt       DateTime  @default(now())
  anulado         Boolean   @default(false)
  anuladoPorId    String?
  anuladoAt       DateTime?
  motivoAnulacion String?

  panel      Panel    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  compra     Compra   @relation(fields: [compraId], references: [id], onDelete: Restrict)
  usuario    Usuario  @relation("GastoCompraUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  anuladoPor Usuario? @relation("GastoCompraAnuladoPor", fields: [anuladoPorId], references: [id], onDelete: Restrict)

  @@index([panelId, compraId])
}

enum EstadoComisionPasista {
  PENDIENTE
  PAGADA
}

/// ORIGINAL: la comisión de la compra. AJUSTE: diferencia (±) cuando la
/// comisión cambió (o se anuló la compra) después de pagada.
enum TipoComisionPasista {
  ORIGINAL
  AJUSTE
}

/// Comisión del pasista por compra: la crea/actualiza/borra pasista.service
/// (sincronizarComisionPasista) en la misma transacción que cambia
/// Compra.comisionPasistaMonto. Pagada, no se modifica ni se borra (trigger):
/// los cambios posteriores van en una fila AJUSTE.
model ComisionPasista {
  id          String                @id @default(cuid())
  panelId     String                @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  compraId    String
  tipo        TipoComisionPasista   @default(ORIGINAL)
  /// ORIGINAL > 0; AJUSTE ≠ 0 (puede ser negativo).
  monto       Decimal               @db.Decimal(12, 2)
  /// % aplicado y base (total de la compra) al momento de calcularla.
  porcentaje  Decimal?              @db.Decimal(5, 2)
  base        Decimal               @db.Decimal(12, 2)
  /// = Compra.fecha.
  fecha       DateTime
  /// Columna GENERADA en la DB: primer día del mes argentino de `fecha` (no se escribe).
  mes         DateTime?             @db.Date
  estado      EstadoComisionPasista @default(PENDIENTE)
  pagadaAt    DateTime?
  pagadaPorId String?
  medioPago   MedioPago?
  referencia  String?
  observacion String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  panel     Panel    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  compra    Compra   @relation(fields: [compraId], references: [id], onDelete: Restrict)
  pagadaPor Usuario? @relation(fields: [pagadaPorId], references: [id], onDelete: Restrict)

  @@unique([panelId, compraId, tipo])
  @@index([panelId, mes, estado])
  @@index([panelId, estado])
}

/// De dónde salió un cambio de Variante.ultimoCosto.
enum OrigenCostoVariante {
  /// Se recibió una compra (costo final del ítem).
  COMPRA_RECIBIDA
  /// Cambiaron la comisión o los gastos de la última compra recibida del sabor.
  COSTOS_FINALES_COMPRA
  /// Ingreso manual de stock con costo informado.
  INGRESO_MANUAL
}

/// Historial INMUTABLE de Variante.ultimoCosto (una fila por cambio).
model CostoVarianteHistorial {
  id            String              @id @default(cuid())
  panelId       String              @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  varianteId    String
  costoAnterior Decimal?            @db.Decimal(12, 2)
  costoNuevo    Decimal             @db.Decimal(12, 2)
  origen        OrigenCostoVariante
  compraId      String?
  usuarioId     String?
  createdAt     DateTime            @default(now())

  panel    Panel    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  compra   Compra?  @relation(fields: [compraId], references: [id], onDelete: Restrict)
  usuario  Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([panelId, varianteId, createdAt])
  @@index([compraId])
}

// -----------------------------------------------------------------------------
// Ventas (se cobran completas en el momento, con un único medio de pago)
// -----------------------------------------------------------------------------

/// Venta: se cobra completa en el momento con un solo medio de pago. Sin
/// galpón, cliente o medio de pago no existe. Inmutable: se anula.
model Venta {
  id                   String      @id @default(cuid())
  panelId              String      @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  /// Correlativo por panel (Secuencia VENTA).
  numero               Int
  /// ID de venta visible: "VAP-000001". Único por panel.
  codigo               String
  fecha                DateTime    @default(now())
  clienteId            String
  depositoId           String
  /// Quién la hizo (rendimiento por vendedor).
  vendedorId           String
  tipo                 TipoVenta   @default(UNITARIA)
  estado               EstadoVenta @default(CONFIRMADA)
  /// Medio principal (informativo): el de mayor monto entre los pagos del
  /// momento de la venta; null si se fió todo. El detalle está en PagoVenta.
  medioPago            MedioPago?
  estadoPago           EstadoPago  @default(PAGADA)
  /// Σ PagoVenta no anulados. Confirmada: montoPagado + saldoPendiente = total (CHECK).
  montoPagado          Decimal     @default(0) @db.Decimal(12, 2)
  saldoPendiente       Decimal     @default(0) @db.Decimal(12, 2)
  subtotal             Decimal     @db.Decimal(12, 2)
  descuento            Decimal     @default(0) @db.Decimal(12, 2)
  /// subtotal − descuento (CHECK en DB).
  total                Decimal     @db.Decimal(12, 2)
  /// Σ cantidad × costoUnitario (snapshot del último costo al vender).
  costoTotal           Decimal     @db.Decimal(12, 2)
  /// total − costoTotal (CHECK en DB).
  gananciaBruta        Decimal     @db.Decimal(12, 2)
  notas                String?
  /// true si el cliente se dio de alta con esta venta (inmutable, como el resto).
  clienteNuevo         Boolean     @default(false)
  /// "Verificar con pistola": TODAS las unidades se escanearon contra el carrito
  /// (varianteId exacto). Lo decide el servidor con el detalle que manda el modal.
  verificadaPorEscaneo Boolean     @default(false)
  /// «Escanea Charly» (solo galpones con escaneoRemoto): null = no se pidió;
  /// PENDIENTE = espera el escaneo; ESCANEADA = todo coincidió (lista para retirar).
  escaneoRemoto        Escaneo?
  escaneoPedidoPorId   String?
  escaneoPedidoAt      DateTime?
  escaneadaPorId       String?
  escaneadaAt          DateTime?
  /// Lo escaneado al confirmar: [{ codigo, varianteId }] (auditoría del escaneo).
  escaneoDetalle       Json?
  /// La cotización de la que salió (trazabilidad).
  cotizacionId         String?     @unique
  anuladaPorId         String?
  motivoAnulacion      String?
  anuladaAt            DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  panel            Panel                @relation(fields: [panelId], references: [id], onDelete: Restrict)
  cotizacion       Cotizacion?          @relation("VentaCotizacion", fields: [cotizacionId], references: [id], onDelete: Restrict)
  cliente          Cliente              @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  deposito         Deposito             @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  vendedor         Usuario              @relation("VentaUsuario", fields: [vendedorId], references: [id], onDelete: Restrict)
  anuladaPor       Usuario?             @relation("VentaAnuladaPor", fields: [anuladaPorId], references: [id], onDelete: Restrict)
  escaneoPedidoPor Usuario?             @relation("VentaEscaneoPedidoPor", fields: [escaneoPedidoPorId], references: [id], onDelete: Restrict)
  escaneadaPor     Usuario?             @relation("VentaEscaneadaPor", fields: [escaneadaPorId], references: [id], onDelete: Restrict)
  items            VentaItem[]
  devoluciones     Devolucion[]
  cotizacionOrigen Cotizacion?          @relation("CotizacionVenta")
  pagos            PagoVenta[]
  /// Facturas de la venta: a lo sumo una EMITIDA (índice único parcial); las anuladas quedan.
  facturas         Factura[]
  /// Venta cobrada por Mercado Libre: la carga de su factura (ARCA). Sin fila = pendiente.
  facturaML        FacturaMercadoLibre?
  clienteCreado    Cliente?             @relation("ClienteCreadoEnVenta")

  @@unique([panelId, numero])
  @@unique([panelId, codigo])
  @@index([panelId, fecha])
  @@index([panelId, estadoPago])
  @@index([panelId, vendedorId, fecha])
  @@index([panelId, clienteId])
  @@index([panelId, tipo, fecha])
  @@index([panelId, depositoId, fecha])
  @@index([panelId, escaneoRemoto])
}

model VentaItem {
  id               String       @id @default(cuid())
  panelId          String       @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  ventaId          String
  varianteId       String
  /// Desnormalizado (= variante.productoId, lo verifica un trigger).
  productoId       String
  cantidad         Int
  /// Precio de lista al momento de vender: precioVentaEfectivo, o el precio
  /// Mercado Libre efectivo si la venta se cobró por ML (origenPrecio = ML).
  precioLista      Decimal      @db.Decimal(12, 2)
  /// Lo cobrado por unidad: el de lista salvo precio especial.
  precioUnitario   Decimal      @db.Decimal(12, 2)
  esPrecioEspecial Boolean      @default(false)
  origenPrecio     OrigenPrecio @default(LISTA)
  /// Snapshot de Variante.ultimoCosto (0 si nunca se compró).
  costoUnitario    Decimal      @db.Decimal(12, 2)
  /// cantidad × precioUnitario (CHECK en DB).
  subtotal         Decimal      @db.Decimal(12, 2)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  panel    Panel    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  venta    Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([panelId, ventaId, varianteId])
  @@index([panelId, varianteId])
  @@index([panelId, productoId])
  @@index([ventaId], map: "venta_item_venta")
}

/// Un pago de una venta: los del momento de vender (pago mixto) y los cobros
/// posteriores de un fiado (esCobroPosterior). Inmutable: solo se anula
/// (un trigger deja cambiar únicamente los campos de anulación).
model PagoVenta {
  id               String    @id @default(cuid())
  panelId          String    @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  ventaId          String
  medioPago        MedioPago
  /// CHECK > 0.
  monto            Decimal   @db.Decimal(12, 2)
  /// Nro. de operación de la transferencia / Binance.
  referencia       String?
  esCobroPosterior Boolean   @default(false)
  /// Agrupa los PagoVenta que salieron de un mismo cobro imputado a varias ventas.
  cobroId          String?
  fecha            DateTime  @default(now())
  usuarioId        String
  anulado          Boolean   @default(false)
  anuladoPorId     String?
  anuladoAt        DateTime?
  motivoAnulacion  String?
  createdAt        DateTime  @default(now())

  panel      Panel    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  venta      Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation("PagoVentaUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  anuladoPor Usuario? @relation("PagoVentaAnuladoPor", fields: [anuladoPorId], references: [id], onDelete: Restrict)

  @@index([panelId, ventaId])
  @@index([panelId, fecha, medioPago])
  @@index([panelId, cobroId])
}

/// Devolución por GARANTÍA: al cliente se le entrega una unidad nueva, que
/// sale del stock del galpón elegido (movimiento GARANTIA). La unidad nueva
/// puede ser del mismo sabor, de otro sabor o de otro modelo (si no hay stock
/// o el cliente prefiere otro): la diferencia de precio se cobra o se devuelve.
model Devolucion {
  id                  String           @id @default(cuid())
  panelId             String           @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  /// Correlativo por panel (Secuencia DEVOLUCION).
  numero              Int
  /// ID visible: "VAP-D-000001". Único por panel.
  codigo              String
  fecha               DateTime         @default(now())
  clienteId           String
  /// La venta original, si se conoce.
  ventaId             String?
  /// De dónde sale la unidad nueva que se entrega.
  depositoId          String
  /// Por qué se devolvió (mínimo 10 caracteres, CHECK en DB).
  observacion         String
  usuarioId           String
  estado              EstadoDevolucion @default(REGISTRADA)
  /// Σ (precioEntregado − precioDevuelto) × cantidad de los ítems: > 0 el
  /// cliente tiene que pagar, < 0 hay que devolverle.
  diferenciaCalculada Decimal          @default(0) @db.Decimal(12, 2)
  /// Lo que efectivamente se cobró (> 0) o se le devolvió (< 0): igual a la
  /// calculada o menos (bonificación), nunca de otro signo (CHECK en DB).
  diferencia          Decimal          @default(0) @db.Decimal(12, 2)
  /// Medio con que se cobró o devolvió la diferencia (null si es 0, CHECK en DB).
  medioPagoDiferencia MedioPago?
  anuladaPorId        String?
  motivoAnulacion     String?
  anuladaAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  panel      Panel            @relation(fields: [panelId], references: [id], onDelete: Restrict)
  cliente    Cliente          @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  venta      Venta?           @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  deposito   Deposito         @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  usuario    Usuario          @relation("DevolucionUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  anuladaPor Usuario?         @relation("DevolucionAnuladaPor", fields: [anuladaPorId], references: [id], onDelete: Restrict)
  items      DevolucionItem[]

  @@unique([panelId, numero])
  @@unique([panelId, codigo])
  @@index([panelId, fecha])
  @@index([panelId, clienteId])
  @@index([panelId, ventaId])
}

model DevolucionItem {
  id                  String   @id @default(cuid())
  panelId             String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  devolucionId        String
  /// El sabor fallado que trae el cliente (no vuelve al stock).
  varianteId          String
  /// Desnormalizado (= variante.productoId, lo verifica un trigger).
  productoId          String
  cantidad            Int
  /// La unidad nueva que se le entrega (sale del stock): el mismo sabor, otro
  /// sabor u otro modelo.
  varianteEntregadaId String
  /// Desnormalizado (= varianteEntregada.productoId, lo verifica un trigger).
  productoEntregadoId String
  /// Precio de lista por unidad, al registrar, de lo devuelto y de lo
  /// entregado. null en las devoluciones anteriores a los cambios.
  precioDevuelto      Decimal? @db.Decimal(12, 2)
  precioEntregado     Decimal? @db.Decimal(12, 2)
  createdAt           DateTime @default(now())

  panel             Panel      @relation(fields: [panelId], references: [id], onDelete: Restrict)
  devolucion        Devolucion @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  variante          Variante   @relation("DevolucionItemDevuelto", fields: [varianteId], references: [id], onDelete: Restrict)
  producto          Producto   @relation("DevolucionItemDevuelto", fields: [productoId], references: [id], onDelete: Restrict)
  varianteEntregada Variante   @relation("DevolucionItemEntregado", fields: [varianteEntregadaId], references: [id], onDelete: Restrict)
  productoEntregado Producto   @relation("DevolucionItemEntregado", fields: [productoEntregadoId], references: [id], onDelete: Restrict)

  @@unique([panelId, devolucionId, varianteId, varianteEntregadaId], map: "DevolucionItem_devolucion_cambio_key")
  @@index([panelId, varianteId])
  @@index([panelId, varianteEntregadaId])
}

// -----------------------------------------------------------------------------
// Transferencias entre depósitos (del mismo panel)
// -----------------------------------------------------------------------------

model Transferencia {
  id                String              @id @default(cuid())
  panelId           String              @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  /// Correlativo por panel (tabla Secuencia).
  numero            Int
  depositoOrigenId  String
  depositoDestinoId String
  /// ID visible: "VAP-T-000001". Único por panel.
  codigo            String
  estado            EstadoTransferencia @default(PENDIENTE)
  fecha             DateTime            @default(now())
  observacion       String?
  /// En desuso desde v2.4: el remito se genera y sirve por Route Handler
  /// (/api/p/{slug}/transferencias/{id}/remito), cacheado en el storage.
  remitoUrl         String?
  usuarioId         String
  completadaAt      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  panel           Panel               @relation(fields: [panelId], references: [id], onDelete: Restrict)
  depositoOrigen  Deposito            @relation("TransferenciaOrigen", fields: [depositoOrigenId], references: [id], onDelete: Restrict)
  depositoDestino Deposito            @relation("TransferenciaDestino", fields: [depositoDestinoId], references: [id], onDelete: Restrict)
