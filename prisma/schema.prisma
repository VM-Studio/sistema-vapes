  productoId      String
  cantidad        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  panel         Panel         @relation(fields: [panelId], references: [id], onDelete: Restrict)
  transferencia Transferencia @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  variante      Variante      @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  producto      Producto      @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([transferenciaId, varianteId])
  @@index([panelId, varianteId])
}

// -----------------------------------------------------------------------------
// Configuración y auditoría
// -----------------------------------------------------------------------------

/// Key-value POR PANEL. Claves: escaner, ventas, alertaStockMinimo, prefijoSku.
model Configuracion {
  id        String   @id @default(cuid())
  panelId   String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  clave     String
  valor     Json
  updatedAt DateTime @updatedAt

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Restrict)

  @@unique([panelId, clave])
}

/// Key-value GLOBAL (fuera de los paneles). Claves: nombreNegocio, iconoApp, timezone,
/// cambio.actualizacionMinutos, cambio.overrideUSDT, cambio.overrideUSD_BLUE, cambio.lease.
model ConfiguracionGlobal {
  id        String   @id @default(cuid())
  clave     String   @unique
  valor     Json
  updatedAt DateTime @updatedAt
}

/// Historial GLOBAL de cotizaciones de moneda (una fila por punta y actualización;
/// nunca se edita). La vigente es la última por (moneda, tipo), salvo que haya un
/// override manual en ConfiguracionGlobal ("cambio.overrideUSDT" / "cambio.overrideUSD_BLUE").
model TipoCambio {
  id         String               @id @default(cuid())
  moneda     MonedaCambio
  tipo       TipoCotizacionCambio
  /// Pesos por unidad de la moneda.
  valor      Decimal              @db.Decimal(14, 2)
  /// Fuente pública de donde salió (ej: "dolarapi.com/blue").
  fuente     String
  /// Hora del dato según la fuente (o la de la consulta si la fuente no la informa).
  obtenidoAt DateTime
  createdAt  DateTime             @default(now())

  @@index([moneda, tipo, obtenidoAt(sort: Desc)])
}

/// INMUTABLE (trigger bloquea UPDATE/DELETE). panelId null = acción global
/// (login, usuarios, configuración).
model AuditLog {
  id           String          @id @default(cuid())
  panelId      String?
  usuarioId    String?
  accion       AccionAuditoria
  /// Nombre de la tabla afectada.
  entidad      String
  entidadId    String?
  datosAntes   Json?
  datosDespues Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime        @default(now())

  panel   Panel?   @relation(fields: [panelId], references: [id], onDelete: Restrict)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([entidad, entidadId])
  @@index([usuarioId, createdAt])
  @@index([panelId, createdAt])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Cotizador (precios mayoristas por escalones y cotizaciones)
// -----------------------------------------------------------------------------

/// Moneda del precio de un escalón mayorista: USD = dólar blue (venta), ARS = pesos.
enum MonedaEscalon {
  USD
  ARS
}

/// Precio mayorista de un producto desde cierta cantidad: aplica a TODOS sus
/// sabores (30 unidades mezclando sabores entran en el escalón de 30).
/// `precioUnitario` está en `moneda`: en USD se convierte a pesos con el blue
/// venta del momento de cotizar (todos los escalones de un producto usan la
/// misma moneda; lo valida escalon.service).
model EscalonPrecio {
  id             String        @id @default(cuid())
  panelId        String        @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  productoId     String
  cantidadMinima Int
  precioUnitario Decimal       @db.Decimal(12, 2)
  moneda         MonedaEscalon @default(USD)
  activo         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  panel    Panel    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([panelId, productoId, cantidadMinima])
}

/// Escalones por defecto del panel (descuento % sobre el precio de lista) para
/// productos sin escalones propios activos.
model EscalonPrecioDefault {
  id                  String   @id @default(cuid())
  panelId             String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  cantidadMinima      Int
  porcentajeDescuento Decimal  @db.Decimal(5, 2)
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Restrict)

  @@unique([panelId, cantidadMinima])
}

model Cotizacion {
  id                   String           @id @default(cuid())
  panelId              String           @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  /// Correlativo por panel (Secuencia COTIZACION).
  numero               Int
  /// ID visible: "VAP-Q-000001".
  codigo               String
  tipo                 TipoCotizacion
  fecha                DateTime         @default(now())
  validaHasta          DateTime
  /// Opcional: puede ser para alguien que todavía no es cliente.
  clienteId            String?
  clienteNombre        String?
  clienteTelefono      String?
  vendedorId           String
  estado               EstadoCotizacion @default(BORRADOR)
  subtotal             Decimal          @db.Decimal(12, 2)
  descuento            Decimal          @default(0) @db.Decimal(12, 2)
  total                Decimal          @db.Decimal(12, 2)
  /// Unitaria cotizada a precio Mercado Libre (cada sabor a su precio ML, si lo tiene).
  aPrecioML            Boolean          @default(false)
  notas                String?
  motivoRechazo        String?
  /// Snapshot del dólar blue venta usado para los precios en USD (mayorista):
  /// mientras la cotización esté vigente sus pesos no cambian aunque cambie el blue.
  tipoCambioBlue       Decimal?         @db.Decimal(14, 2)
  tipoCambioObtenidoAt DateTime?
  /// La venta generada al convertir.
  ventaId              String?          @unique
  /// En desuso desde v2.4: los PDFs se generan y sirven por Route Handler
  /// (/api/p/{slug}/cotizaciones/{id}/pdf), cacheados en el storage.
  pdfUrl               String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  panel         Panel            @relation(fields: [panelId], references: [id], onDelete: Restrict)
  cliente       Cliente?         @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  vendedor      Usuario          @relation("CotizacionVendedor", fields: [vendedorId], references: [id], onDelete: Restrict)
  venta         Venta?           @relation("CotizacionVenta", fields: [ventaId], references: [id], onDelete: Restrict)
  /// Lado inverso de Venta.cotizacionId (la misma venta, vista desde la venta).
  ventaGenerada Venta?           @relation("VentaCotizacion")
  items         CotizacionItem[]

  @@unique([panelId, numero])
  @@unique([panelId, codigo])
  @@index([panelId, fecha])
  @@index([panelId, vendedorId])
  @@index([panelId, estado])
}

model CotizacionItem {
  id                String   @id @default(cuid())
  panelId           String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  cotizacionId      String
  varianteId        String
  /// Desnormalizado (= variante.productoId, lo verifica un trigger).
  productoId        String
  cantidad          Int
  precioLista       Decimal  @db.Decimal(12, 2)
  /// El cotizado: lista, escalón o manual (siempre en pesos).
  precioUnitario    Decimal  @db.Decimal(12, 2)
  /// Precio en dólares si salió de un escalón en USD o de un precio manual en
  /// USD (precioUnitario = USD × Cotizacion.tipoCambioBlue, redondeado a 10).
  precioUnitarioUSD Decimal? @db.Decimal(12, 2)
  /// cantidadMinima del escalón usado (null = lista o manual).
  escalonAplicado   Int?
  esPrecioManual    Boolean  @default(false)
  subtotal          Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  panel      Panel      @relation(fields: [panelId], references: [id], onDelete: Restrict)
  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  variante   Variante   @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  producto   Producto   @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([panelId, cotizacionId, varianteId])
  @@index([panelId, varianteId])
}

/// Historial de precios de un proveedor para un producto: una fila por cada
/// cambio (lo inserta un trigger al crear o cambiar ProveedorProducto).
/// Guarda proveedor y producto propios: sobrevive aunque se quite la
/// asignación (proveedorProductoId pasa a null; es lo único que puede cambiar).
model ProveedorProductoHistorial {
  id                  String   @id @default(cuid())
  panelId             String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  proveedorProductoId String?
  proveedorId         String
  productoId          String
  precio              Decimal  @db.Decimal(12, 2)
  moneda              Moneda
  createdAt           DateTime @default(now())

  panel             Panel              @relation(fields: [panelId], references: [id], onDelete: Restrict)
  proveedorProducto ProveedorProducto? @relation(fields: [proveedorProductoId], references: [id], onDelete: SetNull)
  proveedor         Proveedor          @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  producto          Producto           @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@index([panelId, proveedorProductoId, createdAt])
  @@index([panelId, proveedorId, productoId, createdAt])
}

// -----------------------------------------------------------------------------
// Facturas (por panel): registro de las facturas emitidas por fuera (AFIP) y
// comprobantes internos, vinculadas a ventas. Sin integración AFIP (ver
// src/server/facturacion/emisor.ts).
// -----------------------------------------------------------------------------

/// Factura o comprobante interno. `codigo` = COS-F-000001 (Secuencia FACTURA).
/// Importes: los precios de los ítems son finales (IVA incluido); `total` =
/// Σ ítems − descuento; en la A se discrimina el IVA (`subtotal` neto + `iva`),
/// en B, C e interno `subtotal` = `total` e `iva` = 0. EMITIDA solo cambia a
/// ANULADA (con quién/cuándo/por qué), el PDF subido y el número externo (trigger).
model Factura {
  id              String        @id @default(cuid())
  panelId         String        @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  numero          Int
  codigo          String
  tipo            TipoFactura
  puntoVenta      Int           @default(1)
  /// Número real de AFIP si se emitió por fuera ("0001-00001234").
  numeroExterno   String?
  fecha           DateTime
  ventaId         String?
  clienteId       String
  razonSocial     String?
  /// Solo dígitos (11), con dígito verificador válido.
  cuit            String?
  condicionIva    CondicionIva?
  domicilio       String?
  descuento       Decimal       @default(0) @db.Decimal(12, 2)
  /// Neto (A) o igual al total (B, C, interno).
  subtotal        Decimal       @db.Decimal(12, 2)
  alicuotaIva     Decimal       @default(0) @db.Decimal(5, 2)
  iva             Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  estado          EstadoFactura @default(EMITIDA)
  /// PDF subido (factura real emitida por fuera); null = se genera el comprobante.
  archivoUrl      String?
  observacion     String?
  usuarioId       String
  anuladaPorId    String?
  anuladaAt       DateTime?
  motivoAnulacion String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  panel      Panel         @relation(fields: [panelId], references: [id], onDelete: Restrict)
  venta      Venta?        @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  cliente    Cliente       @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  usuario    Usuario       @relation("FacturaUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  anuladaPor Usuario?      @relation("FacturaAnuladaPor", fields: [anuladaPorId], references: [id], onDelete: Restrict)
  items      FacturaItem[]

  @@unique([panelId, numero])
  @@unique([panelId, codigo])
  @@index([panelId, fecha])
  @@index([panelId, clienteId])
  @@index([ventaId])
}

/// Renglón de una factura (precio final por unidad). Inmutable.
model FacturaItem {
  id             String   @id @default(cuid())
  panelId        String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  facturaId      String
  varianteId     String?
  descripcion    String
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  orden          Int      @default(0)
  createdAt      DateTime @default(now())

  panel    Panel     @relation(fields: [panelId], references: [id], onDelete: Restrict)
  factura  Factura   @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  variante Variante? @relation(fields: [varianteId], references: [id], onDelete: Restrict)

  @@index([facturaId])
}

/// Factura de una venta cobrada por Mercado Libre (medio principal), emitida en
/// ARCA por fuera del sistema. Las ventas ML confirmadas SIN fila acá están
/// "pendientes de cargar"; con fila, "cargadas". `fecha` = la de la factura
/// (default hoy); el archivo (PDF o imagen) es opcional.
model FacturaMercadoLibre {
  id            String   @id @default(cuid())
  panelId       String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  ventaId       String   @unique
  fecha         DateTime
  /// Referencia del storage (privado); null = se marcó cargada sin archivo.
  archivoUrl    String?
  /// MIME detectado: application/pdf, image/png, image/jpeg o image/webp.
  archivoTipo   String?
  /// Nombre original del archivo subido (para la descarga).
  archivoNombre String?
  usuarioId     String
  createdAt     DateTime @default(now())

  panel   Panel   @relation(fields: [panelId], references: [id], onDelete: Restrict)
  venta   Venta   @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([panelId, fecha])
}

// -----------------------------------------------------------------------------
// Ganancia por unidad de los vendedores y liquidación mensual (A3)
// -----------------------------------------------------------------------------

/// Cuánto gana un vendedor por unidad vendida en un panel, según el tipo de
/// venta (UNITARIA = minorista / MAYORISTA) y si el cliente se dio de alta con
/// esa venta (Venta.clienteNuevo). Sin fila = el vendedor no tiene ganancia
/// por unidad en ese panel. La cargan y cambian los dueños (Equipo).
model TarifaVendedor {
  id               String   @id @default(cuid())
  panelId          String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  usuarioId        String
  /// $ por unidad. CHECK ≥ 0.
  minorista        Decimal  @db.Decimal(12, 2)
  mayorista        Decimal  @db.Decimal(12, 2)
  minoristaNuevo   Decimal  @db.Decimal(12, 2)
  mayoristaNuevo   Decimal  @db.Decimal(12, 2)
  actualizadaPorId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  panel          Panel    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  usuario        Usuario  @relation("TarifaVendedorUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  actualizadaPor Usuario? @relation("TarifaVendedorActualizadaPor", fields: [actualizadaPorId], references: [id], onDelete: Restrict)

  @@unique([panelId, usuarioId])
}

enum EstadoLiquidacion {
  /// Mes cerrado, falta pagarle al vendedor.
  PENDIENTE
  /// Se registró el pago (firmado por un dueño): falta la firma del vendedor.
  PAGADA
  /// El vendedor firmó el remito: tiene las dos firmas.
  FIRMADA
}

enum RolFirmaRemito {
  DUENO
  VENDEDOR
}

enum TipoEnvioRemito {
  /// Al vendedor: el remito firmado por el dueño, con el link para firmar.
  PARA_FIRMAR
  /// A los dueños: el remito con las dos firmas.
  FIRMADO
}

enum ResultadoEnvioMail {
  ENVIADO
  /// Sin GMAIL_USER / GMAIL_APP_PASSWORD (o sin destinatarios): no se intentó.
  SIN_CONFIGURAR
  ERROR
}

/// Liquidación mensual de la ganancia por unidad de un vendedor: snapshot
/// (tarifas, categorías y ventas) del mes ya terminado. Única por panel,
/// vendedor y mes. Pagada, el snapshot no se modifica (trigger).
model LiquidacionVendedor {
  id                   String            @id @default(cuid())
  panelId              String            @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  usuarioId            String
  /// Primer día del mes (argentino) liquidado.
  mes                  DateTime          @db.Date
  estado               EstadoLiquidacion @default(PENDIENTE)
  /// Tarifas aplicadas ($ por unidad), snapshot de TarifaVendedor al generar.
  tarifaMinorista      Decimal           @db.Decimal(12, 2)
  tarifaMayorista      Decimal           @db.Decimal(12, 2)
  tarifaMinoristaNuevo Decimal           @db.Decimal(12, 2)
  tarifaMayoristaNuevo Decimal           @db.Decimal(12, 2)
  /// Lo que le corresponde (Σ categorías, nunca negativo).
  total                Decimal           @db.Decimal(12, 2)
  cantidadVentas       Int
  /// Unidades vendidas menos las devueltas en el mes.
  unidades             Int
  /// Σ total de las ventas del mes.
  totalVendido         Decimal           @db.Decimal(12, 2)
  /// [{ categoria, ventas, unidades, unidadesDevueltas, tarifa, monto, totalVendido }]
  categorias           Json
  /// Ventas y devoluciones del mes con su categoría y ganancia (snapshot).
  detalle              Json
  /// null = la generó el sistema al terminar el mes.
  generadaPorId        String?
  generadaAt           DateTime          @default(now())
  /// Pago (estado PAGADA).
  montoPagado          Decimal?          @db.Decimal(12, 2)
  medioPago            MedioPago?
  referencia           String?
  fechaPago            DateTime?
  pagadaPorId          String?
  pagadaAt             DateTime?
  /// Link de firma del vendedor (/firma/{token}): SHA-256 del token (el token
  /// no se guarda), vencimiento y cuándo se usó. Un solo uso.
  firmaTokenHash       String?           @unique
  firmaTokenVenceAt    DateTime?
  firmaTokenUsadoAt    DateTime?
  /// Cuándo firmó el vendedor (estado FIRMADA).
  firmadaAt            DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  firmas      FirmaRemito[]
  envios      EnvioRemito[]
  panel       Panel         @relation(fields: [panelId], references: [id], onDelete: Restrict)
  usuario     Usuario       @relation("LiquidacionVendedor", fields: [usuarioId], references: [id], onDelete: Restrict)
  generadaPor Usuario?      @relation("LiquidacionGeneradaPor", fields: [generadaPorId], references: [id], onDelete: Restrict)
  pagadaPor   Usuario?      @relation("LiquidacionPagadaPor", fields: [pagadaPorId], references: [id], onDelete: Restrict)

  @@unique([panelId, usuarioId, mes])
  @@index([panelId, estado])
}

/// Firma dibujada en el remito de pago de una liquidación: la del dueño que
/// registró el pago y la del vendedor. Una por rol. Inmutable (trigger).
model FirmaRemito {
  id            String         @id @default(cuid())
  panelId       String         @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  liquidacionId String
  rol           RolFirmaRemito
  /// Quién firmó (el dueño logueado, o el vendedor).
  usuarioId     String
  /// Nombre al firmar (para el PDF y el mail).
  nombre        String
  /// PNG de la firma (fondo transparente, re-codificado con sharp; ≤ 200 KB).
  imagen        Bytes
  ip            String?
  userAgent     String?
  /// Por dónde firmó el vendedor: "link" (/firma/{token}) o "sesion".
  medio         String?
  firmadaAt     DateTime       @default(now())

  panel       Panel               @relation(fields: [panelId], references: [id], onDelete: Restrict)
  liquidacion LiquidacionVendedor @relation(fields: [liquidacionId], references: [id], onDelete: Restrict)
  usuario     Usuario             @relation("FirmaRemitoUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@unique([liquidacionId, rol])
  @@index([panelId, liquidacionId])
}

/// Registro de cada envío del remito por mail (a quién, cuándo, resultado).
model EnvioRemito {
  id            String             @id @default(cuid())
  panelId       String             @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  liquidacionId String
  tipo          TipoEnvioRemito
  destinatarios String[]
  /// Quién lo mandó (null = el sistema, al firmar el vendedor por el link).
  enviadoPorId  String?
  resultado     ResultadoEnvioMail
  detalle       String?
  messageId     String?
  createdAt     DateTime           @default(now())

  panel       Panel               @relation(fields: [panelId], references: [id], onDelete: Restrict)
  liquidacion LiquidacionVendedor @relation(fields: [liquidacionId], references: [id], onDelete: Restrict)
  enviadoPor  Usuario?            @relation("EnvioRemitoUsuario", fields: [enviadoPorId], references: [id], onDelete: Restrict)

  @@index([panelId, liquidacionId, createdAt])
}
