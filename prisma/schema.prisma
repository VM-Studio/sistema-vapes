// =============================================================================
// Sistema de gestión multipanel — capa de datos
//
// Reglas de diseño (ver también prisma/migrations/*_constraints/migration.sql):
// - Dinero: Decimal(12,2). Cantidades: Int. IDs: cuid().
// - Soft delete (deletedAt) en entidades maestras. Nunca DELETE físico de negocio.
// - Stock es un caché del ledger MovimientoStock: solo cambia en la misma
//   transacción que inserta un movimiento (lo garantizan triggers en la DB).
// - MovimientoStock y AuditLog son inmutables (triggers bloquean UPDATE/DELETE).
// - Las restricciones que Prisma no sabe expresar (CHECK, índices únicos
//   parciales, triggers, vistas) viven en la migración "constraints".
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  // relationJoins: `include` se resuelve con JOINs en UNA query (buscarPorCodigo
  // lo usa con relationLoadStrategy: "join"; sin esto Prisma hace 1 query por relación).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  /// App: en producción, el pooler (PgBouncer / Neon pooler, modo transaction) con connection_limit.
  url       = env("DATABASE_URL")
  /// Migraciones: conexión directa (sin pooler) con el usuario de migraciones.
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum RolUsuario {
  OWNER
  EMPLEADO
}

/// Por panel: DASHBOARD..REPORTES (PermisoUsuario con panelId).
/// Globales (solo OWNER, sin filas de permiso): USUARIOS, CONFIGURACION.
enum Modulo {
  DASHBOARD
  PROVEEDORES
  PRODUCTOS
  STOCK
  VENTAS
  CLIENTES
  DEVOLUCIONES
  COMPRAS
  COTIZADOR
  REPORTES
  USUARIOS
  CONFIGURACION
}

enum TipoMovimiento {
  INGRESO_COMPRA
  INGRESO_MANUAL
  VENTA
  /// Histórico (anulación de ventas antes de R3). Nuevas anulaciones: VENTA_ANULADA.
  DEVOLUCION_CLIENTE
  DEVOLUCION_PROVEEDOR
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  /// Egreso: la unidad nueva que se le entrega al cliente por una falla (garantía).
  GARANTIA
  /// Ingreso: se anuló una devolución por garantía.
  GARANTIA_ANULADA
  /// Ingreso: se anuló una venta (vuelve la mercadería).
  VENTA_ANULADA
}

enum EstadoVenta {
  CONFIRMADA
  ANULADA
}

enum TipoVenta {
  UNITARIA
  MAYORISTA
}

enum TipoCotizacion {
  UNITARIA
  MAYORISTA
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
  CONVERTIDA
}

enum EstadoDevolucion {
  REGISTRADA
  ANULADA
}

enum EstadoCompra {
  BORRADOR
  RECIBIDA
  ANULADA
}

enum EstadoTransferencia {
  PENDIENTE
  COMPLETADA
  ANULADA
}

enum Moneda {
  ARS
  USD
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  BINANCE
}

enum AccionAuditoria {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PERMISO_CAMBIADO
  /// Intento de hacer algo sin permiso (Forbidden).
  ACCESO_DENEGADO
  SESION_REVOCADA
}

// -----------------------------------------------------------------------------
// Usuarios y permisos
// -----------------------------------------------------------------------------

model Usuario {
  id                   String     @id @default(cuid())
  nombre               String
  /// Siempre en minúsculas (CHECK en DB + toLowerCase() en Zod).
  email                String     @unique
  passwordHash         String
  rol                  RolUsuario
  activo               Boolean    @default(true)
  /// true => al iniciar sesión se lo obliga a ir a /cuenta a cambiarla.
  debeCambiarPassword  Boolean    @default(false)
  ultimoLogin          DateTime?
  /// Comisión orientativa (solo referencia en el dashboard; null = no se muestra).
  comisionUnitariaPct  Decimal?   @db.Decimal(5, 2)
  comisionMayoristaPct Decimal?   @db.Decimal(5, 2)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?

  permisos             PermisoUsuario[]
  paneles              UsuarioPanel[]
  movimientos          MovimientoStock[]
  compras              Compra[]
  ventas               Venta[]             @relation("VentaUsuario")
  ventasAnuladas       Venta[]             @relation("VentaAnuladaPor")
  transferencias       Transferencia[]
  auditLogs            AuditLog[]
  devoluciones         Devolucion[]        @relation("DevolucionUsuario")
  devolucionesAnuladas Devolucion[]        @relation("DevolucionAnuladaPor")
  cotizaciones         Cotizacion[]        @relation("CotizacionVendedor")
  preciosProveedor     ProveedorProducto[]
  sesiones             Sesion[]            @relation("SesionUsuario")
  sesionesRevocadas    Sesion[]            @relation("SesionRevocadaPor")
}

/// Sesión de login (el JWT lleva su id como `sid`). Revocarla corta el acceso
/// en el próximo request (el middleware la consulta con caché de 60 s).
model Sesion {
  id            String    @id @default(cuid())
  usuarioId     String
  /// sha256 del secreto aleatorio que viaja en el JWT (`tok`): un sid solo no alcanza.
  tokenHash     String
  userAgent     String?
  ip            String?
  createdAt     DateTime  @default(now())
  ultimoUso     DateTime  @default(now())
  expiraAt      DateTime
  revocadaAt    DateTime?
  revocadaPorId String?

  usuario     Usuario  @relation("SesionUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  revocadaPor Usuario? @relation("SesionRevocadaPor", fields: [revocadaPorId], references: [id], onDelete: SetNull)

  @@index([usuarioId, revocadaAt])
  @@index([expiraAt])
}

/// Registro de cada backup (pg_dump) y su verificación.
model Backup {
  id         String   @id @default(cuid())
  /// Clave en el bucket de backups (backups/backup-YYYY-MM-DD-HHmm.dump).
  archivo    String
  tamanio    BigInt?
  duracionMs Int
  ok         Boolean
  error      String?
  /// "cron" | "manual" | "release"
  origen     String   @default("cron")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Rate limit con ventana deslizante aproximada (ventanas de 1 minuto).
model RateLimit {
  clave    String
  ventana  DateTime
  contador Int      @default(0)

  @@id([clave, ventana])
  @@index([ventana])
}

/// Registro de intentos de login para rate limit (persistente: sobrevive a
/// redeploys y funciona con múltiples instancias, a diferencia de memoria).
model IntentoLogin {
  id        String   @id @default(cuid())
  /// Normalizado (trim + minúsculas). No es FK: se registran emails inexistentes.
  email     String
  ip        String?
  exitoso   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

/// Permisos de un EMPLEADO por panel y módulo. Los OWNER tienen acceso total
/// por rol y no necesitan filas acá (ni en UsuarioPanel).
model PermisoUsuario {
  id            String   @id @default(cuid())
  usuarioId     String
  panelId       String
  modulo        Modulo
  puedeVer      Boolean  @default(false)
  puedeCrear    Boolean  @default(false)
  puedeEditar   Boolean  @default(false)
  puedeEliminar Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  panel   Panel   @relation(fields: [panelId], references: [id], onDelete: Restrict)

  @@unique([usuarioId, panelId, modulo])
  @@index([panelId])
}

/// Paneles a los que accede un EMPLEADO (los OWNER acceden a todos sin filas).
model UsuarioPanel {
  id        String   @id @default(cuid())
  usuarioId String
  panelId   String
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  panel   Panel   @relation(fields: [panelId], references: [id], onDelete: Restrict)

  @@unique([usuarioId, panelId])
  @@index([panelId])
}

// -----------------------------------------------------------------------------
// Paneles: sistemas independientes dentro de la app (Vapes, Cosmetic, ...).
// Toda tabla de negocio tiene panelId; los servicios la consultan SOLO con
// dbPara(panelId) (src/server/db/panel-scoped.ts). La DB además verifica que
// cada fila apunte a filas de su mismo panel (trigger fn_verificar_mismo_panel)
// y que panelId no cambie nunca.
//
// panelId tiene DEFAULT current_setting('app.panel_id'): nadie la setea, así
// que un INSERT que olvide el panel falla por NOT NULL en vez de guardar datos
// huérfanos (y, de paso, Prisma lo tipa como opcional: lo inyecta dbPara).
// -----------------------------------------------------------------------------

model Panel {
  id                     String   @id @default(cuid())
  nombre                 String   @unique
  /// kebab-case: /p/{slug}. El prefijo del ID de venta sale de acá (VAP-000001).
  slug                   String   @unique
  logoUrl                String?
  /// Hex (#RRGGBB): tiñe botón primario e ítems activos dentro del panel.
  colorAcento            String?
  /// Cómo llama el panel al atributo principal de sus productos ("Pitadas", "Contenido"...).
  etiquetaEspecificacion String
  /// Cómo se llaman las unidades vendidas en el dashboard ("Vapes vendidos" en Vapes).
  etiquetaUnidades       String   @default("Unidades vendidas")
  orden                  Int      @default(0)
  activo                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  usuarios                  UsuarioPanel[]
  permisos                  PermisoUsuario[]
  depositos                 Deposito[]
  categorias                Categoria[]
  marcas                    Marca[]
  proveedores               Proveedor[]
  proveedorProductos        ProveedorProducto[]
  clientes                  Cliente[]
  productos                 Producto[]
  variantes                 Variante[]
  codigosAlternativos       CodigoBarrasAlternativo[]
  stocks                    Stock[]
  movimientos               MovimientoStock[]
  compras                   Compra[]
  compraItems               CompraItem[]
  ventas                    Venta[]
  ventaItems                VentaItem[]
  devoluciones              Devolucion[]
  devolucionItems           DevolucionItem[]
  escalones                 EscalonPrecio[]
  escalonesDefault          EscalonPrecioDefault[]
  historialPreciosProveedor ProveedorProductoHistorial[]
  cotizaciones              Cotizacion[]
  cotizacionItems           CotizacionItem[]
  transferencias            Transferencia[]
  transferenciaItems        TransferenciaItem[]
  configuraciones           Configuracion[]
  secuencias                Secuencia[]
  auditLogs                 AuditLog[]

  @@index([activo, orden])
}

/// Numeración correlativa por panel y entidad ("VENTA", "COMPRA", "TRANSFERENCIA",
/// "DEVOLUCION"). Se toma con SELECT ... FOR UPDATE dentro de la transacción.
model Secuencia {
  id           String   @id @default(cuid())
  panelId      String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  entidad      String
  ultimoNumero Int      @default(0)
  updatedAt    DateTime @updatedAt

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Restrict)

  @@unique([panelId, entidad])
}

// -----------------------------------------------------------------------------
// Maestros (por panel)
// -----------------------------------------------------------------------------

model Deposito {
  id          String   @id @default(cuid())
  panelId     String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  nombre      String
  direccion   String?
  activo      Boolean  @default(true)
  /// Un solo depósito principal por panel (índice único parcial en SQL).
  esPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  panel                 Panel             @relation(fields: [panelId], references: [id], onDelete: Restrict)
  stocks                Stock[]
  movimientos           MovimientoStock[]
  compras               Compra[]
  ventas                Venta[]
  transferenciasOrigen  Transferencia[]   @relation("TransferenciaOrigen")
  transferenciasDestino Transferencia[]   @relation("TransferenciaDestino")
  devoluciones          Devolucion[]

  @@unique([panelId, nombre])
}

model Categoria {
  id          String   @id @default(cuid())
  panelId     String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  panel     Panel      @relation(fields: [panelId], references: [id], onDelete: Restrict)
  productos Producto[]

  @@unique([panelId, nombre])
}

model Marca {
  id        String   @id @default(cuid())
  panelId   String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  panel     Panel      @relation(fields: [panelId], references: [id], onDelete: Restrict)
  productos Producto[]

  @@unique([panelId, nombre])
}

model Proveedor {
  id           String    @id @default(cuid())
  panelId      String    @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  /// Persona de contacto.
  nombre       String
  /// Normalizado ("+54" + dígitos). Único por panel entre proveedores no borrados (índice parcial en SQL).
  telefono     String?
  nombreTienda String
  notas        String?
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  panel            Panel                        @relation(fields: [panelId], references: [id], onDelete: Restrict)
  compras          Compra[]
  productos        ProveedorProducto[]
  historialPrecios ProveedorProductoHistorial[]

  @@index([panelId, nombre])
  @@index([panelId, nombreTienda])
}

/// Qué vende cada proveedor y a cuánto (precio de compra unitario por
/// producto, sin importar el sabor). Se pisa al editarlo y al recibir una
/// compra con "actualizar precio del proveedor".
model ProveedorProducto {
  id            String   @id @default(cuid())
  panelId       String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  proveedorId   String
  productoId    String
  precio        Decimal  @db.Decimal(12, 2)
  moneda        Moneda   @default(ARS)
  actualizadoAt DateTime @default(now())
  /// Quién fijó el precio vigente.
  usuarioId     String
  createdAt     DateTime @default(now())

  panel     Panel                        @relation(fields: [panelId], references: [id], onDelete: Restrict)
  proveedor Proveedor                    @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  producto  Producto                     @relation(fields: [productoId], references: [id], onDelete: Restrict)
  usuario   Usuario                      @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  historial ProveedorProductoHistorial[]

  @@unique([panelId, proveedorId, productoId])
  /// Comparador de precios: proveedores de un producto, de menor a mayor.
  @@index([panelId, productoId, precio])
}

model Cliente {
  id        String    @id @default(cuid())
  panelId   String    @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  nombre    String
  /// Obligatorio, normalizado "+54" + dígitos. Único por panel entre clientes no
  /// borrados (índice único parcial en SQL + CHECK de formato).
  telefono  String
  notas     String?
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  panel        Panel        @relation(fields: [panelId], references: [id], onDelete: Restrict)
  ventas       Venta[]
  devoluciones Devolucion[]
  cotizaciones Cotizacion[]

  @@index([panelId, nombre])
  @@index([nombre(ops: raw("gin_trgm_ops"))], type: Gin, map: "cliente_nombre_trgm")
  @@index([telefono(ops: raw("gin_trgm_ops"))], type: Gin, map: "cliente_telefono_trgm")
}

// -----------------------------------------------------------------------------
// Catálogo
// -----------------------------------------------------------------------------

/// Producto = marca + modelo + especificación ("Elf Bar" + "BC" + "5000").
/// Todo producto tiene variantes (sabores); uno sin sabor tiene una sola
/// variante "Único" que la UI no muestra como tal.
model Producto {
  id                 String    @id @default(cuid())
  panelId            String    @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  marcaId            String
  /// El modelo (ej. "BC").
  nombre             String
  /// El atributo principal del panel (Panel.etiquetaEspecificacion): "5000" pitadas en Vapes.
  especificacion     String    @default("")
  /// Mantenido por trigger: lower(especificacion) sin espacios. Compara "mismo producto".
  especificacionNorm String    @default("")
  /// Mantenido por trigger: "{Marca} {Modelo} {Especificación}" (búsquedas y toda la UI).
  nombreCompleto     String    @default("")
  categoriaId        String?
  /// Precio unitario de venta de todos sus sabores (salvo los que tienen precio propio).
  precioVenta        Decimal   @db.Decimal(12, 2)
  imagenUrl          String?
  activo             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  panel                     Panel                        @relation(fields: [panelId], references: [id], onDelete: Restrict)
  categoria                 Categoria?                   @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  marca                     Marca                        @relation(fields: [marcaId], references: [id], onDelete: Restrict)
  variantes                 Variante[]
  proveedores               ProveedorProducto[]
  compraItems               CompraItem[]
  ventaItems                VentaItem[]
  devolucionItems           DevolucionItem[]
  escalones                 EscalonPrecio[]
  cotizacionItems           CotizacionItem[]
  historialPreciosProveedor ProveedorProductoHistorial[]

  @@unique([panelId, marcaId, nombre, especificacionNorm])
  @@index([panelId, categoriaId])
  @@index([panelId, marcaId])
  /// Trigram (pg_trgm) para búsquedas ILIKE '%texto%'.
  @@index([nombreCompleto(ops: raw("gin_trgm_ops"))], type: Gin, map: "producto_nombre_completo_trgm")
}

/// Variante = sabor de un producto. El stock es por variante y depósito.
model Variante {
  id           String    @id @default(cuid())
  /// Desnormalizado (= Producto.panelId, lo verifica un trigger): buscar por
  /// código de barras dentro de un panel no necesita join.
  panelId      String    @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  productoId   String
  /// El sabor ("Mango Ice"). "Único" para productos sin sabor.
  nombre       String
  /// Formato PRD-XXXXXX si no se provee. Único por panel.
  sku          String
  /// Único por panel (junto con CodigoBarrasAlternativo.codigo) entre variantes no borradas.
  codigoBarras String?
  /// null = usa Producto.precioVenta. Solo para un sabor con precio distinto.
  precioVenta  Decimal?  @db.Decimal(12, 2)
  /// Costo de la última compra recibida (snapshot que toma cada venta).
  ultimoCosto  Decimal?  @db.Decimal(12, 2)
  stockMinimo  Int       @default(0)
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  panel               Panel                     @relation(fields: [panelId], references: [id], onDelete: Restrict)
  producto            Producto                  @relation(fields: [productoId], references: [id], onDelete: Restrict)
  codigosAlternativos CodigoBarrasAlternativo[]
  stocks              Stock[]
  movimientos         MovimientoStock[]
  compraItems         CompraItem[]
  ventaItems          VentaItem[]
  devolucionItems     DevolucionItem[]
  cotizacionItems     CotizacionItem[]
  transferenciaItems  TransferenciaItem[]

  @@unique([panelId, sku])
  @@unique([panelId, productoId, nombre])
  /// Trigram (pg_trgm) para búsquedas ILIKE '%texto%'.
  @@index([nombre(ops: raw("gin_trgm_ops"))], type: Gin, map: "variante_nombre_trgm")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "variante_sku_trgm")
}

/// Un mismo producto puede venir con más de un código según lote/importador.
model CodigoBarrasAlternativo {
  id          String   @id @default(cuid())
  panelId     String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  varianteId  String
  codigo      String
  descripcion String?
  createdAt   DateTime @default(now())

  panel    Panel    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)

  @@unique([panelId, codigo])
  @@index([varianteId])
}

// -----------------------------------------------------------------------------
// Inventario
// -----------------------------------------------------------------------------

/// Caché del ledger. NUNCA se actualiza directo: solo vía registrarMovimiento().
/// Un trigger rechaza cualquier cambio de cantidad sin movimiento en la misma tx.
model Stock {
  id         String   @id @default(cuid())
  panelId    String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  varianteId String
  depositoId String
  cantidad   Int      @default(0)
  updatedAt  DateTime @updatedAt

  panel    Panel    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  deposito Deposito @relation(fields: [depositoId], references: [id], onDelete: Restrict)

  @@unique([panelId, varianteId, depositoId])
  @@index([panelId, depositoId])
}

/// Ledger INMUTABLE. Sin updatedAt. Los errores se corrigen con AJUSTE inverso.
model MovimientoStock {
  id             String         @id @default(cuid())
  panelId        String         @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  tipo           TipoMovimiento
  varianteId     String
  depositoId     String
  /// Siempre > 0: el signo lo define el tipo.
  cantidad       Int
  stockAnterior  Int
  stockPosterior Int
  costoUnitario  Decimal?       @db.Decimal(12, 2)
  motivo         String?
  /// "VENTA" | "COMPRA" | "TRANSFERENCIA" | "AJUSTE" | "DEVOLUCION" (CHECK en DB).
  referenciaTipo String?
  referenciaId   String?
  usuarioId      String
  createdAt      DateTime       @default(now())

  panel    Panel    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  deposito Deposito @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([panelId, varianteId, depositoId, createdAt])
  @@index([panelId, createdAt])
  @@index([panelId, depositoId, createdAt])
  @@index([referenciaTipo, referenciaId])
  @@index([usuarioId])
}

// -----------------------------------------------------------------------------
// Compras
// -----------------------------------------------------------------------------

model Compra {
  id          String       @id @default(cuid())
  panelId     String       @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  /// Correlativo por panel (tabla Secuencia).
  numero      Int
  proveedorId String?
  /// Depósito donde ingresa la mercadería.
  depositoId  String
  fecha       DateTime     @default(now())
  estado      EstadoCompra @default(BORRADOR)
  subtotal    Decimal      @db.Decimal(12, 2)
  descuento   Decimal      @default(0) @db.Decimal(12, 2)
  total       Decimal      @db.Decimal(12, 2)
  notas       String?
  usuarioId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  panel     Panel        @relation(fields: [panelId], references: [id], onDelete: Restrict)
  proveedor Proveedor?   @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  deposito  Deposito     @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  usuario   Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  items     CompraItem[]

  @@unique([panelId, numero])
  @@index([panelId, fecha])
  @@index([panelId, proveedorId])
  @@index([panelId, depositoId])
  @@index([usuarioId])
}

/// Se compra por sabor (el stock es por sabor); productoId desnormalizado
/// (= variante.productoId, lo verifica un trigger) para precios por proveedor.
model CompraItem {
  id            String   @id @default(cuid())
  panelId       String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  compraId      String
  varianteId    String
  productoId    String
  cantidad      Int
  costoUnitario Decimal  @db.Decimal(12, 2)
  subtotal      Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  panel    Panel    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  compra   Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([compraId, varianteId])
  @@index([panelId, varianteId])
  @@index([panelId, productoId])
}

// -----------------------------------------------------------------------------
// Ventas (se cobran completas en el momento, con un único medio de pago)
// -----------------------------------------------------------------------------

/// Venta: se cobra completa en el momento con un solo medio de pago. Sin
/// galpón, cliente o medio de pago no existe. Inmutable: se anula.
model Venta {
  id              String      @id @default(cuid())
  panelId         String      @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  /// Correlativo por panel (Secuencia VENTA).
  numero          Int
  /// ID de venta visible: "VAP-000001". Único por panel.
  codigo          String
  fecha           DateTime    @default(now())
  clienteId       String
  depositoId      String
  /// Quién la hizo (rendimiento por vendedor).
  vendedorId      String
  tipo            TipoVenta   @default(UNITARIA)
  estado          EstadoVenta @default(CONFIRMADA)
  medioPago       MedioPago
  subtotal        Decimal     @db.Decimal(12, 2)
  descuento       Decimal     @default(0) @db.Decimal(12, 2)
  /// subtotal − descuento (CHECK en DB).
  total           Decimal     @db.Decimal(12, 2)
  /// Σ cantidad × costoUnitario (snapshot del último costo al vender).
  costoTotal      Decimal     @db.Decimal(12, 2)
  /// total − costoTotal (CHECK en DB).
  gananciaBruta   Decimal     @db.Decimal(12, 2)
  notas           String?
  /// La cotización de la que salió (trazabilidad).
  cotizacionId    String?     @unique
  anuladaPorId    String?
  motivoAnulacion String?
  anuladaAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  panel            Panel        @relation(fields: [panelId], references: [id], onDelete: Restrict)
  cotizacion       Cotizacion?  @relation("VentaCotizacion", fields: [cotizacionId], references: [id], onDelete: Restrict)
  cliente          Cliente      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  deposito         Deposito     @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  vendedor         Usuario      @relation("VentaUsuario", fields: [vendedorId], references: [id], onDelete: Restrict)
  anuladaPor       Usuario?     @relation("VentaAnuladaPor", fields: [anuladaPorId], references: [id], onDelete: Restrict)
  items            VentaItem[]
  devoluciones     Devolucion[]
  cotizacionOrigen Cotizacion?  @relation("CotizacionVenta")

  @@unique([panelId, numero])
  @@unique([panelId, codigo])
  @@index([panelId, fecha])
  @@index([panelId, vendedorId, fecha])
  @@index([panelId, clienteId])
  @@index([panelId, tipo, fecha])
  @@index([panelId, depositoId, fecha])
}

model VentaItem {
  id               String   @id @default(cuid())
  panelId          String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  ventaId          String
  varianteId       String
  /// Desnormalizado (= variante.productoId, lo verifica un trigger).
  productoId       String
  cantidad         Int
  /// precioVentaEfectivo al momento de vender.
  precioLista      Decimal  @db.Decimal(12, 2)
  /// Lo cobrado por unidad: el de lista salvo precio especial.
  precioUnitario   Decimal  @db.Decimal(12, 2)
  esPrecioEspecial Boolean  @default(false)
  /// Snapshot de Variante.ultimoCosto (0 si nunca se compró).
  costoUnitario    Decimal  @db.Decimal(12, 2)
  /// cantidad × precioUnitario (CHECK en DB).
  subtotal         Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  panel    Panel    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  venta    Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([panelId, ventaId, varianteId])
  @@index([panelId, varianteId])
  @@index([panelId, productoId])
  @@index([ventaId], map: "venta_item_venta")
}

/// Devolución por GARANTÍA: al cliente se le entrega una unidad nueva, que
/// sale del stock del galpón elegido (movimiento GARANTIA).
model Devolucion {
  id              String           @id @default(cuid())
  panelId         String           @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  /// Correlativo por panel (Secuencia DEVOLUCION).
  numero          Int
  /// ID visible: "VAP-D-000001". Único por panel.
  codigo          String
  fecha           DateTime         @default(now())
  clienteId       String
  /// La venta original, si se conoce.
  ventaId         String?
  /// De dónde sale la unidad nueva que se entrega.
  depositoId      String
  /// Por qué se devolvió (mínimo 10 caracteres, CHECK en DB).
  observacion     String
  usuarioId       String
  estado          EstadoDevolucion @default(REGISTRADA)
  anuladaPorId    String?
  motivoAnulacion String?
  anuladaAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  panel      Panel            @relation(fields: [panelId], references: [id], onDelete: Restrict)
  cliente    Cliente          @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  venta      Venta?           @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  deposito   Deposito         @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  usuario    Usuario          @relation("DevolucionUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  anuladaPor Usuario?         @relation("DevolucionAnuladaPor", fields: [anuladaPorId], references: [id], onDelete: Restrict)
  items      DevolucionItem[]

  @@unique([panelId, numero])
  @@unique([panelId, codigo])
  @@index([panelId, fecha])
  @@index([panelId, clienteId])
  @@index([panelId, ventaId])
}

model DevolucionItem {
  id           String   @id @default(cuid())
  panelId      String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  devolucionId String
  varianteId   String
  /// Desnormalizado (= variante.productoId, lo verifica un trigger).
  productoId   String
  cantidad     Int
  createdAt    DateTime @default(now())

  panel      Panel      @relation(fields: [panelId], references: [id], onDelete: Restrict)
  devolucion Devolucion @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  variante   Variante   @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  producto   Producto   @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([panelId, devolucionId, varianteId])
  @@index([panelId, varianteId])
}

// -----------------------------------------------------------------------------
// Transferencias entre depósitos (del mismo panel)
// -----------------------------------------------------------------------------

model Transferencia {
  id                String              @id @default(cuid())
  panelId           String              @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  /// Correlativo por panel (tabla Secuencia).
  numero            Int
  depositoOrigenId  String
  depositoDestinoId String
  estado            EstadoTransferencia @default(PENDIENTE)
  fecha             DateTime            @default(now())
  notas             String?
  usuarioId         String
  completadaAt      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  panel           Panel               @relation(fields: [panelId], references: [id], onDelete: Restrict)
  depositoOrigen  Deposito            @relation("TransferenciaOrigen", fields: [depositoOrigenId], references: [id], onDelete: Restrict)
  depositoDestino Deposito            @relation("TransferenciaDestino", fields: [depositoDestinoId], references: [id], onDelete: Restrict)
  usuario         Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  items           TransferenciaItem[]

  @@unique([panelId, numero])
  @@index([panelId, fecha])
  @@index([panelId, estado])
  @@index([depositoOrigenId])
  @@index([depositoDestinoId])
  @@index([usuarioId])
}

model TransferenciaItem {
  id              String   @id @default(cuid())
  panelId         String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  transferenciaId String
  varianteId      String
  cantidad        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  panel         Panel         @relation(fields: [panelId], references: [id], onDelete: Restrict)
  transferencia Transferencia @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  variante      Variante      @relation(fields: [varianteId], references: [id], onDelete: Restrict)

  @@unique([transferenciaId, varianteId])
  @@index([panelId, varianteId])
}

// -----------------------------------------------------------------------------
// Configuración y auditoría
// -----------------------------------------------------------------------------

/// Key-value POR PANEL. Claves: escaner, ventas, alertaStockMinimo, prefijoSku.
model Configuracion {
  id        String   @id @default(cuid())
  panelId   String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  clave     String
  valor     Json
  updatedAt DateTime @updatedAt

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Restrict)

  @@unique([panelId, clave])
}

/// Key-value GLOBAL (fuera de los paneles). Claves: nombreNegocio, iconoApp, timezone.
model ConfiguracionGlobal {
  id        String   @id @default(cuid())
  clave     String   @unique
  valor     Json
  updatedAt DateTime @updatedAt
}

/// INMUTABLE (trigger bloquea UPDATE/DELETE). panelId null = acción global
/// (login, usuarios, configuración).
model AuditLog {
  id           String          @id @default(cuid())
  panelId      String?
  usuarioId    String?
  accion       AccionAuditoria
  /// Nombre de la tabla afectada.
  entidad      String
  entidadId    String?
  datosAntes   Json?
  datosDespues Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime        @default(now())

  panel   Panel?   @relation(fields: [panelId], references: [id], onDelete: Restrict)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([entidad, entidadId])
  @@index([usuarioId, createdAt])
  @@index([panelId, createdAt])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Cotizador (precios mayoristas por escalones y cotizaciones)
// -----------------------------------------------------------------------------

/// Precio mayorista de un producto desde cierta cantidad: aplica a TODOS sus
/// sabores (30 unidades mezclando sabores entran en el escalón de 30).
model EscalonPrecio {
  id             String   @id @default(cuid())
  panelId        String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  productoId     String
  cantidadMinima Int
  precioUnitario Decimal  @db.Decimal(12, 2)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  panel    Panel    @relation(fields: [panelId], references: [id], onDelete: Restrict)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([panelId, productoId, cantidadMinima])
}

/// Escalones por defecto del panel (descuento % sobre el precio de lista) para
/// productos sin escalones propios activos.
model EscalonPrecioDefault {
  id                  String   @id @default(cuid())
  panelId             String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  cantidadMinima      Int
  porcentajeDescuento Decimal  @db.Decimal(5, 2)
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Restrict)

  @@unique([panelId, cantidadMinima])
}

model Cotizacion {
  id              String           @id @default(cuid())
  panelId         String           @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  /// Correlativo por panel (Secuencia COTIZACION).
  numero          Int
  /// ID visible: "VAP-Q-000001".
  codigo          String
  tipo            TipoCotizacion
  fecha           DateTime         @default(now())
  validaHasta     DateTime
  /// Opcional: puede ser para alguien que todavía no es cliente.
  clienteId       String?
  clienteNombre   String?
  clienteTelefono String?
  vendedorId      String
  estado          EstadoCotizacion @default(BORRADOR)
  subtotal        Decimal          @db.Decimal(12, 2)
  descuento       Decimal          @default(0) @db.Decimal(12, 2)
  total           Decimal          @db.Decimal(12, 2)
  notas           String?
  motivoRechazo   String?
  /// La venta generada al convertir.
  ventaId         String?          @unique
  pdfUrl          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  panel         Panel            @relation(fields: [panelId], references: [id], onDelete: Restrict)
  cliente       Cliente?         @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  vendedor      Usuario          @relation("CotizacionVendedor", fields: [vendedorId], references: [id], onDelete: Restrict)
  venta         Venta?           @relation("CotizacionVenta", fields: [ventaId], references: [id], onDelete: Restrict)
  /// Lado inverso de Venta.cotizacionId (la misma venta, vista desde la venta).
  ventaGenerada Venta?           @relation("VentaCotizacion")
  items         CotizacionItem[]

  @@unique([panelId, numero])
  @@unique([panelId, codigo])
  @@index([panelId, fecha])
  @@index([panelId, vendedorId])
  @@index([panelId, estado])
}

model CotizacionItem {
  id              String   @id @default(cuid())
  panelId         String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  cotizacionId    String
  varianteId      String
  /// Desnormalizado (= variante.productoId, lo verifica un trigger).
  productoId      String
  cantidad        Int
  precioLista     Decimal  @db.Decimal(12, 2)
  /// El cotizado: lista, escalón o manual.
  precioUnitario  Decimal  @db.Decimal(12, 2)
  /// cantidadMinima del escalón usado (null = lista o manual).
  escalonAplicado Int?
  esPrecioManual  Boolean  @default(false)
  subtotal        Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  panel      Panel      @relation(fields: [panelId], references: [id], onDelete: Restrict)
  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  variante   Variante   @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  producto   Producto   @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([panelId, cotizacionId, varianteId])
  @@index([panelId, varianteId])
}

/// Historial de precios de un proveedor para un producto: una fila por cada
/// cambio (lo inserta un trigger al crear o cambiar ProveedorProducto).
/// Guarda proveedor y producto propios: sobrevive aunque se quite la
/// asignación (proveedorProductoId pasa a null; es lo único que puede cambiar).
model ProveedorProductoHistorial {
  id                  String   @id @default(cuid())
  panelId             String   @default(dbgenerated("current_setting('app.panel_id'::text, true)"))
  proveedorProductoId String?
  proveedorId         String
  productoId          String
  precio              Decimal  @db.Decimal(12, 2)
  moneda              Moneda
  createdAt           DateTime @default(now())

  panel             Panel              @relation(fields: [panelId], references: [id], onDelete: Restrict)
  proveedorProducto ProveedorProducto? @relation(fields: [proveedorProductoId], references: [id], onDelete: SetNull)
  proveedor         Proveedor          @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  producto          Producto           @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@index([panelId, proveedorProductoId, createdAt])
  @@index([panelId, proveedorId, productoId, createdAt])
}
