// =============================================================================
// Sistema de gestión — capa de datos
//
// Reglas de diseño (ver también prisma/migrations/*_constraints/migration.sql):
// - Dinero: Decimal(12,2). Cantidades: Int. IDs: cuid().
// - Soft delete (deletedAt) en entidades maestras. Nunca DELETE físico de negocio.
// - Stock es un caché del ledger MovimientoStock: solo cambia en la misma
//   transacción que inserta un movimiento (lo garantizan triggers en la DB).
// - MovimientoStock y AuditLog son inmutables (triggers bloquean UPDATE/DELETE).
// - Las restricciones que Prisma no sabe expresar (CHECK, índices únicos
//   parciales, triggers, vistas) viven en la migración "constraints".
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  // relationJoins: `include` se resuelve con JOINs en UNA query (buscarPorCodigo
  // lo usa con relationLoadStrategy: "join"; sin esto Prisma hace 1 query por relación).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum RolUsuario {
  OWNER
  EMPLEADO
}

enum Modulo {
  DASHBOARD
  PRODUCTOS
  INVENTARIO
  MOVIMIENTOS
  VENTAS
  COMPRAS
  CLIENTES
  PROVEEDORES
  REPORTES
  USUARIOS
  CONFIGURACION
  /// Costos, ganancias, valorización (se suma a REPORTES / DASHBOARD).
  FINANZAS
  GASTOS
  CAJA
}

enum TipoMovimiento {
  INGRESO_COMPRA
  INGRESO_MANUAL
  VENTA
  DEVOLUCION_CLIENTE
  DEVOLUCION_PROVEEDOR
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
}

enum EstadoVenta {
  BORRADOR
  CONFIRMADA
  ANULADA
}

enum EstadoCompra {
  BORRADOR
  RECIBIDA
  ANULADA
}

enum EstadoTransferencia {
  PENDIENTE
  COMPLETADA
  ANULADA
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  DEBITO
  CREDITO
  MERCADOPAGO
  OTRO
  /// Saldo a favor del cliente (devoluciones acreditadas a su cuenta).
  CREDITO_CLIENTE
}

enum EstadoPago {
  PAGADA
  PARCIAL
  PENDIENTE
}

enum EstadoComprobante {
  EMITIDO
  ANULADO
}

enum TipoComprobante {
  TICKET
  FACTURA_A
  FACTURA_B
  FACTURA_C
  PRESUPUESTO
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

/// Signo del monto: APERTURA ≥ 0, VENTA/PAGO_CLIENTE/INGRESO_EXTRA > 0,
/// DEVOLUCION/GASTO/RETIRO < 0, CIERRE ≤ 0 (= −montoContado). CHECK en DB.
enum TipoMovimientoCaja {
  APERTURA
  VENTA
  PAGO_CLIENTE
  DEVOLUCION
  GASTO
  RETIRO
  INGRESO_EXTRA
  CIERRE
}

enum TipoNotificacion {
  STOCK_BAJO
  SIN_STOCK
  CAJA_DIFERENCIA
  TRANSFERENCIA_PENDIENTE
  DEUDA_CLIENTE
}

enum AccionAuditoria {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PERMISO_CAMBIADO
}

// -----------------------------------------------------------------------------
// Usuarios y permisos
// -----------------------------------------------------------------------------

model Usuario {
  id                  String     @id @default(cuid())
  nombre              String
  /// Siempre en minúsculas (CHECK en DB + toLowerCase() en Zod).
  email               String     @unique
  passwordHash        String
  rol                 RolUsuario
  activo              Boolean    @default(true)
  /// true => al iniciar sesión se lo obliga a ir a /cuenta a cambiarla.
  debeCambiarPassword Boolean    @default(false)
  ultimoLogin         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  permisos         PermisoUsuario[]
  movimientos      MovimientoStock[]
  compras          Compra[]
  ventas           Venta[]           @relation("VentaUsuario")
  ventasAnuladas   Venta[]           @relation("VentaAnuladaPor")
  transferencias   Transferencia[]
  gastos           Gasto[]
  auditLogs        AuditLog[]
  historialPrecios HistorialPrecio[]
  pagosVenta       PagoVenta[]       @relation("PagoUsuario")
  pagosAnulados    PagoVenta[]       @relation("PagoAnuladoPor")
  devoluciones     Devolucion[]
  cajasAbiertas    Caja[]            @relation("CajaAbiertaPor")
  cajasCerradas    Caja[]            @relation("CajaCerradaPor")
  movimientosCaja  MovimientoCaja[]
  notificaciones   Notificacion[]
}

/// Registro de intentos de login para rate limit (persistente: sobrevive a
/// redeploys y funciona con múltiples instancias, a diferencia de memoria).
model IntentoLogin {
  id        String   @id @default(cuid())
  /// Normalizado (trim + minúsculas). No es FK: se registran emails inexistentes.
  email     String
  ip        String?
  exitoso   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

/// Los OWNER tienen acceso total por rol y no necesitan filas acá.
model PermisoUsuario {
  id            String   @id @default(cuid())
  usuarioId     String
  modulo        Modulo
  puedeVer      Boolean  @default(false)
  puedeCrear    Boolean  @default(false)
  puedeEditar   Boolean  @default(false)
  puedeEliminar Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, modulo])
}

// -----------------------------------------------------------------------------
// Maestros
// -----------------------------------------------------------------------------

model Deposito {
  id          String   @id @default(cuid())
  nombre      String   @unique
  direccion   String?
  activo      Boolean  @default(true)
  /// Solo un depósito puede ser principal (índice único parcial en SQL).
  esPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stocks                Stock[]
  movimientos           MovimientoStock[]
  compras               Compra[]
  ventas                Venta[]
  transferenciasOrigen  Transferencia[]   @relation("TransferenciaOrigen")
  transferenciasDestino Transferencia[]   @relation("TransferenciaDestino")
  devoluciones          Devolucion[]
  gastos                Gasto[]
  cajas                 Caja[]
  resumenes             ResumenDiario[]
}

model Categoria {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productos Producto[]
}

model Marca {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productos Producto[]
}

model Proveedor {
  id        String    @id @default(cuid())
  nombre    String
  /// Único entre proveedores no borrados (índice único parcial en SQL).
  cuit      String?
  telefono  String?
  email     String?
  direccion String?
  notas     String?
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  compras Compra[]
}

model Cliente {
  id            String    @id @default(cuid())
  nombre        String
  apellido      String?
  /// Único entre clientes no borrados (índice único parcial en SQL).
  documento     String?
  telefono      String?
  email         String?
  direccion     String?
  notas         String?
  activo        Boolean   @default(true)
  /// null = no se le vende fiado. Solo el OWNER lo edita.
  limiteCredito Decimal?  @db.Decimal(12, 2)
  /// Caché: Σ saldoPendiente de sus ventas confirmadas (verificado por trigger diferido).
  saldoDeudor   Decimal   @default(0) @db.Decimal(12, 2)
  /// Crédito por devoluciones acreditadas a cuenta; se usa como medio CREDITO_CLIENTE.
  saldoAFavor   Decimal   @default(0) @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  ventas Venta[]

  @@index([nombre(ops: raw("gin_trgm_ops"))], type: Gin, map: "cliente_nombre_trgm")
  @@index([apellido(ops: raw("gin_trgm_ops"))], type: Gin, map: "cliente_apellido_trgm")
  @@index([documento(ops: raw("gin_trgm_ops"))], type: Gin, map: "cliente_documento_trgm")
  @@index([telefono(ops: raw("gin_trgm_ops"))], type: Gin, map: "cliente_telefono_trgm")
}

// -----------------------------------------------------------------------------
// Catálogo
// -----------------------------------------------------------------------------

model Producto {
  id             String    @id @default(cuid())
  nombre         String
  descripcion    String?
  categoriaId    String
  marcaId        String?
  /// false => existe exactamente una variante "Único".
  tieneVariantes Boolean   @default(false)
  imagenUrl      String?
  activo         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  categoria Categoria  @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  marca     Marca?     @relation(fields: [marcaId], references: [id], onDelete: Restrict)
  variantes Variante[]

  @@unique([nombre, marcaId])
  @@index([categoriaId])
  @@index([marcaId])
  /// Trigram (pg_trgm) para búsquedas ILIKE '%texto%'.
  @@index([nombre(ops: raw("gin_trgm_ops"))], type: Gin, map: "producto_nombre_trgm")
}

model Variante {
  id           String    @id @default(cuid())
  productoId   String
  /// Ej: "Mango Ice". "Único" para productos sin variantes.
  nombre       String
  /// Formato PRD-XXXXXX si no se provee.
  sku          String    @unique
  /// Único (junto con CodigoBarrasAlternativo.codigo) entre variantes no borradas.
  codigoBarras String?
  precioCosto  Decimal   @db.Decimal(12, 2)
  precioVenta  Decimal   @db.Decimal(12, 2)
  stockMinimo  Int       @default(0)
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  producto            Producto                  @relation(fields: [productoId], references: [id], onDelete: Restrict)
  codigosAlternativos CodigoBarrasAlternativo[]
  stocks              Stock[]
  movimientos         MovimientoStock[]
  compraItems         CompraItem[]
  ventaItems          VentaItem[]
  transferenciaItems  TransferenciaItem[]
  historialPrecios    HistorialPrecio[]

  @@unique([productoId, nombre])
  /// Trigram (pg_trgm) para búsquedas ILIKE '%texto%'.
  @@index([nombre(ops: raw("gin_trgm_ops"))], type: Gin, map: "variante_nombre_trgm")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "variante_sku_trgm")
}

/// INMUTABLE. Una fila por cada cambio de precio de una variante. La DB exige
/// que todo cambio de precio de Variante venga con su fila acá (misma tx).
model HistorialPrecio {
  id                  String   @id @default(cuid())
  varianteId          String
  precioCostoAnterior Decimal  @db.Decimal(12, 2)
  precioCostoNuevo    Decimal  @db.Decimal(12, 2)
  precioVentaAnterior Decimal  @db.Decimal(12, 2)
  precioVentaNuevo    Decimal  @db.Decimal(12, 2)
  usuarioId           String
  motivo              String?
  createdAt           DateTime @default(now())

  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([varianteId, createdAt])
  @@index([createdAt])
  @@index([usuarioId])
}

/// Un mismo producto puede venir con más de un código según lote/importador.
model CodigoBarrasAlternativo {
  id          String   @id @default(cuid())
  varianteId  String
  codigo      String   @unique
  descripcion String?
  createdAt   DateTime @default(now())

  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)

  @@index([varianteId])
}

// -----------------------------------------------------------------------------
// Inventario
// -----------------------------------------------------------------------------

/// Caché del ledger. NUNCA se actualiza directo: solo vía registrarMovimiento().
/// Un trigger rechaza cualquier cambio de cantidad sin movimiento en la misma tx.
model Stock {
  id         String   @id @default(cuid())
  varianteId String
  depositoId String
  cantidad   Int      @default(0)
  updatedAt  DateTime @updatedAt

  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  deposito Deposito @relation(fields: [depositoId], references: [id], onDelete: Restrict)

  @@unique([varianteId, depositoId])
  @@index([depositoId])
}

/// Ledger INMUTABLE. Sin updatedAt. Los errores se corrigen con AJUSTE inverso.
model MovimientoStock {
  id             String         @id @default(cuid())
  tipo           TipoMovimiento
  varianteId     String
  depositoId     String
  /// Siempre > 0: el signo lo define el tipo.
  cantidad       Int
  stockAnterior  Int
  stockPosterior Int
  costoUnitario  Decimal?       @db.Decimal(12, 2)
  motivo         String?
  /// "VENTA" | "COMPRA" | "TRANSFERENCIA" | "AJUSTE" (CHECK en DB).
  referenciaTipo String?
  referenciaId   String?
  usuarioId      String
  createdAt      DateTime       @default(now())

  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  deposito Deposito @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([varianteId, depositoId, createdAt])
  @@index([createdAt])
  @@index([referenciaTipo, referenciaId])
  @@index([depositoId])
  @@index([usuarioId])
}

// -----------------------------------------------------------------------------
// Compras
// -----------------------------------------------------------------------------

model Compra {
  id          String       @id @default(cuid())
  numero      Int          @unique @default(autoincrement())
  proveedorId String?
  /// Depósito donde ingresa la mercadería.
  depositoId  String
  fecha       DateTime     @default(now())
  estado      EstadoCompra @default(BORRADOR)
  subtotal    Decimal      @db.Decimal(12, 2)
  descuento   Decimal      @default(0) @db.Decimal(12, 2)
  total       Decimal      @db.Decimal(12, 2)
  notas       String?
  usuarioId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  proveedor Proveedor?   @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  deposito  Deposito     @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  usuario   Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  items     CompraItem[]

  @@index([fecha])
  @@index([proveedorId])
  @@index([depositoId])
  @@index([usuarioId])
}

model CompraItem {
  id            String   @id @default(cuid())
  compraId      String
  varianteId    String
  cantidad      Int
  costoUnitario Decimal  @db.Decimal(12, 2)
  subtotal      Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  compra   Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)

  @@unique([compraId, varianteId])
  @@index([varianteId])
}

// -----------------------------------------------------------------------------
// Ventas y facturación interna
// -----------------------------------------------------------------------------

model Venta {
  id              String      @id @default(cuid())
  numero          Int         @unique @default(autoincrement())
  fecha           DateTime    @default(now())
  clienteId       String?
  /// Depósito de donde sale la mercadería.
  depositoId      String
  estado          EstadoVenta @default(BORRADOR)
  subtotal        Decimal     @db.Decimal(12, 2)
  descuento       Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  /// Snapshot: suma de costoUnitario * cantidad de los ítems.
  costoTotal      Decimal     @db.Decimal(12, 2)
  /// total - costoTotal (CHECK en DB).
  gananciaBruta   Decimal     @db.Decimal(12, 2)
  /// Medio principal (el de mayor monto), informativo: la verdad son los PagoVenta.
  medioPago       MedioPago?
  estadoPago      EstadoPago  @default(PENDIENTE)
  /// Σ pagos vigentes (verificado por trigger diferido).
  montoPagado     Decimal     @default(0) @db.Decimal(12, 2)
  /// total − montoPagado (lo que queda en cuenta corriente).
  saldoPendiente  Decimal     @default(0) @db.Decimal(12, 2)
  /// Ajuste por redondear el total (≤ 0: siempre a favor del cliente).
  redondeo        Decimal     @default(0) @db.Decimal(12, 2)
  notas           String?
  usuarioId       String
  anuladaPorId    String?
  motivoAnulacion String?
  anuladaAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  cliente      Cliente?     @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  deposito     Deposito     @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  usuario      Usuario      @relation("VentaUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  anuladaPor   Usuario?     @relation("VentaAnuladaPor", fields: [anuladaPorId], references: [id], onDelete: Restrict)
  items        VentaItem[]
  comprobante  Comprobante?
  pagos        PagoVenta[]
  devoluciones Devolucion[]

  @@index([fecha])
  @@index([estado, fecha])
  @@index([clienteId, estado])
  @@index([depositoId, fecha])
  /// Dashboard de un empleado sin REPORTES: solo sus ventas del período.
  @@index([usuarioId, fecha])
}

model VentaItem {
  id               String   @id @default(cuid())
  ventaId          String
  varianteId       String
  cantidad         Int
  /// Snapshot del precio de venta al momento de la venta.
  precioUnitario   Decimal  @db.Decimal(12, 2)
  /// Snapshot del costo al momento de la venta (ganancia histórica estable).
  costoUnitario    Decimal  @db.Decimal(12, 2)
  descuento        Decimal  @default(0) @db.Decimal(12, 2)
  /// cantidad * precioUnitario - descuento (CHECK en DB).
  subtotal         Decimal  @db.Decimal(12, 2)
  /// Caché: Σ DevolucionItem.cantidad (verificado por trigger diferido).
  cantidadDevuelta Int      @default(0)
  /// Ej: "precio modificado por Ana de $16.000 a $15.000".
  notas            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  venta        Venta            @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  variante     Variante         @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  devoluciones DevolucionItem[]

  @@unique([ventaId, varianteId])
  @@index([varianteId])
}

/// Facturación interna. Preparado para AFIP (cae, caeVencimiento).
model Comprobante {
  id             String            @id @default(cuid())
  ventaId        String            @unique
  tipo           TipoComprobante
  puntoVenta     Int               @default(1)
  numero         Int
  fecha          DateTime          @default(now())
  razonSocial    String?
  cuit           String?
  condicionIva   String?
  total          Decimal           @db.Decimal(12, 2)
  estado         EstadoComprobante @default(EMITIDO)
  anuladoAt      DateTime?
  pdfUrl         String?
  /// AFIP (factura electrónica): se completan al integrar WSFE. Hoy sin uso.
  cae            String?
  caeVencimiento DateTime?
  createdAt      DateTime          @default(now())

  venta Venta @relation(fields: [ventaId], references: [id], onDelete: Restrict)

  @@unique([tipo, puntoVenta, numero])
}

/// Numeración correlativa por (tipo, puntoVenta). Se toma con SELECT ... FOR UPDATE.
model SecuenciaComprobante {
  id           String          @id @default(cuid())
  tipo         TipoComprobante
  puntoVenta   Int             @default(1)
  ultimoNumero Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([tipo, puntoVenta])
}

// -----------------------------------------------------------------------------
// Transferencias entre depósitos
// -----------------------------------------------------------------------------

model Transferencia {
  id                String              @id @default(cuid())
  numero            Int                 @unique @default(autoincrement())
  depositoOrigenId  String
  depositoDestinoId String
  estado            EstadoTransferencia @default(PENDIENTE)
  fecha             DateTime            @default(now())
  notas             String?
  usuarioId         String
  completadaAt      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  depositoOrigen  Deposito            @relation("TransferenciaOrigen", fields: [depositoOrigenId], references: [id], onDelete: Restrict)
  depositoDestino Deposito            @relation("TransferenciaDestino", fields: [depositoDestinoId], references: [id], onDelete: Restrict)
  usuario         Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  items           TransferenciaItem[]

  @@index([fecha])
  @@index([depositoOrigenId])
  @@index([depositoDestinoId])
  @@index([usuarioId])
}

model TransferenciaItem {
  id              String   @id @default(cuid())
  transferenciaId String
  varianteId      String
  cantidad        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transferencia Transferencia @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  variante      Variante      @relation(fields: [varianteId], references: [id], onDelete: Restrict)

  @@unique([transferenciaId, varianteId])
  @@index([varianteId])
}

// -----------------------------------------------------------------------------
// Gastos, configuración y auditoría
// -----------------------------------------------------------------------------

model CategoriaGasto {
  id     String  @id @default(cuid())
  nombre String  @unique
  activo Boolean @default(true)

  gastos Gasto[]
}

/// Para calcular ganancia neta. Soft delete. Si se pagó en efectivo desde una
/// caja abierta, `cajaId` apunta a ella (y hay un MovimientoCaja GASTO).
model Gasto {
  id               String    @id @default(cuid())
  fecha            DateTime  @default(now())
  categoriaGastoId String
  descripcion      String
  monto            Decimal   @db.Decimal(12, 2)
  medioPago        MedioPago
  /// Gasto atribuible a un galpón (null = general del negocio).
  depositoId       String?
  cajaId           String?
  /// Foto del ticket (StorageProvider).
  comprobanteUrl   String?
  /// Solo recordatorio: aparece en "recurrentes sin cargar" el mes siguiente.
  recurrente       Boolean   @default(false)
  usuarioId        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  categoria CategoriaGasto @relation(fields: [categoriaGastoId], references: [id], onDelete: Restrict)
  deposito  Deposito?      @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  caja      Caja?          @relation(fields: [cajaId], references: [id], onDelete: Restrict)
  usuario   Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([fecha])
  @@index([usuarioId])
  @@index([categoriaGastoId, fecha])
  @@index([depositoId, fecha])
  @@index([cajaId])
}

// -----------------------------------------------------------------------------
// Caja (efectivo físico por depósito)
// -----------------------------------------------------------------------------

/// Una sola ABIERTA por depósito (índice único parcial). Cerrada = inmutable.
model Caja {
  id               String     @id @default(cuid())
  depositoId       String
  estado           EstadoCaja @default(ABIERTA)
  abiertaPorId     String
  abiertaAt        DateTime   @default(now())
  montoInicial     Decimal    @db.Decimal(12, 2)
  cerradaPorId     String?
  cerradaAt        DateTime?
  /// Σ movimientos (sin el CIERRE) al momento de cerrar.
  montoEsperado    Decimal?   @db.Decimal(12, 2)
  /// Arqueo real.
  montoContado     Decimal?   @db.Decimal(12, 2)
  /// contado − esperado.
  diferencia       Decimal?   @db.Decimal(12, 2)
  observaciones    String?
  /// |diferencia| > toleranciaArqueo.
  requiereRevision Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  deposito    Deposito         @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  abiertaPor  Usuario          @relation("CajaAbiertaPor", fields: [abiertaPorId], references: [id], onDelete: Restrict)
  cerradaPor  Usuario?         @relation("CajaCerradaPor", fields: [cerradaPorId], references: [id], onDelete: Restrict)
  movimientos MovimientoCaja[]
  pagos       PagoVenta[]
  gastos      Gasto[]

  @@index([depositoId, abiertaAt])
  @@index([estado])
  @@index([abiertaAt])
}

/// INMUTABLE. Solo efectivo: la caja es la caja física.
model MovimientoCaja {
  id             String             @id @default(cuid())
  cajaId         String
  tipo           TipoMovimientoCaja
  /// Con signo (ver TipoMovimientoCaja).
  monto          Decimal            @db.Decimal(12, 2)
  /// "VENTA" | "PAGO" | "DEVOLUCION" | "GASTO".
  referenciaTipo String?
  referenciaId   String?
  descripcion    String?
  usuarioId      String
  createdAt      DateTime           @default(now())

  caja    Caja    @relation(fields: [cajaId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([cajaId, createdAt])
  @@index([referenciaTipo, referenciaId])
}

// -----------------------------------------------------------------------------
// Reportes y notificaciones
// -----------------------------------------------------------------------------

/// Agregados por día (zona horaria configurada) para que el dashboard no
/// recorra años de ventas. depositoId null = consolidado. Se recalcula
/// (upsert) dentro de cada transacción que afecta un día; `pnpm reportes:rebuild`
/// la reconstruye entera. UNIQUE (fecha, depositoId) NULLS NOT DISTINCT.
model ResumenDiario {
  id                String   @id @default(cuid())
  fecha             DateTime @db.Date
  depositoId        String?
  cantidadVentas    Int      @default(0)
  unidadesVendidas  Int      @default(0)
  totalVentas       Decimal  @default(0) @db.Decimal(14, 2)
  costoVentas       Decimal  @default(0) @db.Decimal(14, 2)
  /// totalVentas − costoVentas.
  gananciaBruta     Decimal  @default(0) @db.Decimal(14, 2)
  totalGastos       Decimal  @default(0) @db.Decimal(14, 2)
  /// gananciaBruta − (devoluciones − costoDevoluciones) − totalGastos.
  gananciaNeta      Decimal  @default(0) @db.Decimal(14, 2)
  /// Cobrado ese día por medio: { "EFECTIVO": "1000.00", ... }.
  totalPorMedioPago Json     @default("{}")
  /// Importe devuelto ese día.
  devoluciones      Decimal  @default(0) @db.Decimal(14, 2)
  /// Costo de la mercadería devuelta (vuelve al stock): la devolución solo resta su margen.
  costoDevoluciones Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt         DateTime @updatedAt

  deposito Deposito? @relation(fields: [depositoId], references: [id], onDelete: Restrict)

  @@unique([fecha, depositoId])
  @@index([depositoId, fecha])
}

model Notificacion {
  id        String           @id @default(cuid())
  tipo      TipoNotificacion
  titulo    String
  mensaje   String
  /// { clave, href, ... }. `clave` deduplica (no se repite mientras haya una sin leer).
  datos     Json?
  leida     Boolean          @default(false)
  /// Destinatario (null = todos los dueños).
  usuarioId String?
  createdAt DateTime         @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, leida, createdAt])
  @@index([createdAt])
}

/// Key-value. Claves: nombreNegocio, moneda, alertaStockMinimo, prefijoSku, escaner, ventas,
/// timezone, exigirCajaAbierta, toleranciaArqueo, diasCobertura, rotacion, ultimasAlertas.
model Configuracion {
  id        String   @id @default(cuid())
  clave     String   @unique
  valor     Json
  updatedAt DateTime @updatedAt
}

/// INMUTABLE (trigger bloquea UPDATE/DELETE).
model AuditLog {
  id           String          @id @default(cuid())
  usuarioId    String?
  accion       AccionAuditoria
  /// Nombre de la tabla afectada.
  entidad      String
  entidadId    String?
  datosAntes   Json?
  datosDespues Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime        @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([entidad, entidadId])
  @@index([usuarioId, createdAt])
  @@index([createdAt])
}

/// Un pago de una venta (pago partido y cobros posteriores de cuenta corriente).
/// No se borra ni se edita: se anula (solo cambian los campos de anulación).
model PagoVenta {
  id              String    @id @default(cuid())
  ventaId         String
  medioPago       MedioPago
  monto           Decimal   @db.Decimal(12, 2)
  /// Nro de operación (transferencia / MercadoPago) o "Devolución #N".
  referencia      String?
  fecha           DateTime  @default(now())
  usuarioId       String
  anulado         Boolean   @default(false)
  anuladoPorId    String?
  anuladoAt       DateTime?
  motivoAnulacion String?
  /// Efectivo cobrado con la caja del depósito abierta (null = fuera de caja o no efectivo).
  cajaId          String?
  createdAt       DateTime  @default(now())

  venta      Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  caja       Caja?    @relation(fields: [cajaId], references: [id], onDelete: Restrict)
  usuario    Usuario  @relation("PagoUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  anuladoPor Usuario? @relation("PagoAnuladoPor", fields: [anuladoPorId], references: [id], onDelete: Restrict)

  @@index([ventaId])
  @@index([fecha, medioPago])
  @@index([cajaId])
}

/// Devolución (parcial o total) de productos de una venta confirmada.
model Devolucion {
  id                 String     @id @default(cuid())
  numero             Int        @unique @default(autoincrement())
  ventaId            String
  /// Depósito al que vuelve la mercadería.
  depositoId         String
  fecha              DateTime   @default(now())
  motivo             String
  total              Decimal    @db.Decimal(12, 2)
  reintegroMedioPago MedioPago?
  reintegroMonto     Decimal    @default(0) @db.Decimal(12, 2)
  /// Parte acreditada al cliente (cancela deuda y el resto queda como saldo a favor).
  aCuentaCorriente   Decimal    @default(0) @db.Decimal(12, 2)
  usuarioId          String
  createdAt          DateTime   @default(now())

  venta    Venta            @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  deposito Deposito         @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  usuario  Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  items    DevolucionItem[]

  @@index([ventaId])
  @@index([fecha])
  /// Recalcular ResumenDiario de un depósito y un día.
  @@index([depositoId, fecha])
}

model DevolucionItem {
  id             String  @id @default(cuid())
  devolucionId   String
  ventaItemId    String
  cantidad       Int
  /// Snapshot del precio efectivo del ítem (con el descuento global prorrateado).
  precioUnitario Decimal @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  devolucion Devolucion @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  ventaItem  VentaItem  @relation(fields: [ventaItemId], references: [id], onDelete: Restrict)

  @@index([devolucionId])
  @@index([ventaItemId])
}
