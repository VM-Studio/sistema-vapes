{
  "name": "sistema-vapes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "test:stock": "PRISMA_LOG=silent tsx --conditions=react-server scripts/test-stock.ts",
    "postinstall": "prisma generate",
    "test:integridad": "PRISMA_LOG=silent tsx --conditions=react-server scripts/test-integridad.ts",
    "test": "pnpm test:stock && pnpm test:integridad && pnpm test:auth",
    "test:auth": "PRISMA_LOG=silent tsx --conditions=react-server --env-file=.env scripts/test-auth.ts",
    "test:e2e": "node scripts/e2e-auth.mjs",
    "test:catalogo": "PRISMA_LOG=query tsx --conditions=react-server --env-file=.env scripts/test-catalogo.ts",
    "test:e2e:catalogo": "node scripts/e2e-catalogo.mjs",
    "test:unit": "vitest run",
    "test:compras": "PRISMA_LOG=silent tsx --conditions=react-server --env-file=.env scripts/test-compras.ts",
    "test:e2e:escaner": "node scripts/e2e-escaner.mjs",
    "test:ventas": "PRISMA_LOG=silent tsx --conditions=react-server --env-file=.env scripts/test-ventas.ts",
    "test:ventas:concurrencia": "PRISMA_LOG=silent tsx --conditions=react-server --env-file=.env scripts/test-ventas-concurrentes.ts",
    "test:e2e:ventas": "node scripts/e2e-ventas.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "15.5.26",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "unrs-resolver",
      "sharp"
    ]
  }
}
