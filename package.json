{
  "name": "sistema-vapes",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "test:stock": "PRISMA_LOG=silent tsx --conditions=react-server scripts/test-stock.ts",
    "postinstall": "prisma generate",
    "test:integridad": "PRISMA_LOG=silent tsx --conditions=react-server scripts/test-integridad.ts",
    "test": "vitest run",
    "test:auth": "PRISMA_LOG=silent tsx --conditions=react-server --env-file=.env scripts/test-auth.ts",
    "test:e2e": "playwright test",
    "test:catalogo": "PRISMA_LOG=silent tsx --conditions=react-server --env-file=.env scripts/test-catalogo.ts",
    "test:unit": "vitest run",
    "test:compras": "PRISMA_LOG=silent tsx --conditions=react-server --env-file=.env scripts/test-compras.ts",
    "test:ventas": "PRISMA_LOG=silent tsx --conditions=react-server --env-file=.env scripts/test-ventas.ts",
    "test:ventas:concurrencia": "PRISMA_LOG=silent tsx --conditions=react-server --env-file=.env scripts/test-ventas-concurrentes.ts",
    "db:seed-demo": "PRISMA_LOG=silent tsx --conditions=react-server prisma/seed-demo.ts",
    "iconos": "tsx scripts/generar-iconos.ts",
    "backup": "tsx --env-file-if-exists=.env --conditions=react-server scripts/backup.ts",
    "restore": "tsx --env-file-if-exists=.env --conditions=react-server scripts/restore.ts",
    "test:restore": "PRISMA_LOG=silent tsx --env-file-if-exists=.env --conditions=react-server scripts/test-restore.ts",
    "crear-owner": "tsx --env-file-if-exists=.env scripts/crear-owner.ts",
    "test:scripts": "pnpm test:stock && pnpm test:integridad && pnpm test:auth",
    "storage:migrate": "tsx --env-file-if-exists=.env --conditions=react-server scripts/storage-migrate.ts",
    "release": "tsx --env-file-if-exists=.env --conditions=react-server scripts/release.ts",
    "test:cotizador": "PRISMA_LOG=silent tsx --conditions=react-server --env-file=.env scripts/test-cotizador.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "@serwist/turbopack": "9.5.12",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "esbuild-wasm": "~0.25.12",
    "exceljs": "^4.4.0",
    "idb": "^8.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "next": "15.5.26",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "rimraf": "^2.7.1",
    "server-only": "^0.0.1",
    "serwist": "9.5.12",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@serwist/cli": "9.5.12",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "unrs-resolver",
      "sharp"
    ],
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "tmp@<0.2.6": "^0.2.6",
      "uuid@<11.1.1": "^11.1.1",
      "browserslist@<4.28.7": "^4.28.7",
      "deepmerge-ts@<8": "^8.0.0"
    },
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "x64"
      ],
      "libc": [
        "current",
        "glibc"
      ]
    }
  }
}
