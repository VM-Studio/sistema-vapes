# =============================================================================
# Variables de entorno. Se validan al arrancar (src/env.ts): si falta algo
# obligatorio o tiene mal formato, el servidor NO arranca y dice qué falta.
#
# Entornos:
#   local       → este archivo copiado a .env (docker compose, STORAGE local)
#   test / CI   → DATABASE_URL_TEST (base descartable; Playwright y vitest)
#   preview     → Vercel Preview: base y bucket PROPIOS, nunca los de producción
#   producción  → Vercel Production / Railway: todas las marcadas (prod)
# Solo las NEXT_PUBLIC_* llegan al navegador: nunca pongas un secreto ahí.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# App: a través del POOLER (Neon "-pooler", Supabase :6543, PgBouncer), con
# pocos slots por instancia serverless.
#   prod: postgresql://app_runtime:***@host-pooler/db?sslmode=require&pgbouncer=true&connection_limit=5
DATABASE_URL="postgresql://app:app@localhost:5433/gestion?schema=public"
# Conexión DIRECTA (sin pooler): migraciones, pg_dump y pg_restore.
#   prod: postgresql://app_migraciones:***@host/db?sslmode=require
DIRECT_URL="postgresql://app:app@localhost:5433/gestion?schema=public"
# Base para tests E2E (se BORRA y recrea en cada corrida; el nombre tiene que contener "e2e" o "test").
DATABASE_URL_TEST="postgresql://app:app@localhost:5433/gestion_e2e"
# Puerto del host para el contenedor de Postgres (docker compose).
DB_PORT=5433

# --- Seguridad ---------------------------------------------------------------
# Firma de sesiones (JWT HS256). Mínimo 32 caracteres. (prod) Generar: openssl rand -base64 32
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres"
# Jobs programados (/api/cron/*): header "Authorization: Bearer <CRON_SECRET>". (prod) openssl rand -hex 32
CRON_SECRET=""
# URL pública de la app, sin barra final. (prod) Define el origen permitido
# para Server Actions, las cookies seguras, HTTPS en la CSP y los links de WhatsApp.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Requests por minuto por usuario/IP a /api y Server Actions.
RATE_LIMIT_POR_MINUTO=300
# El seed se niega a correr en producción salvo ALLOW_SEED=true (una sola vez, a propósito).
ALLOW_SEED=false

# --- Archivos (comprobantes, fotos, íconos) ----------------------------------
# local: carpeta STORAGE_DIR (desarrollo). s3: Cloudflare R2 o cualquier S3 (producción).
STORAGE_PROVIDER=local
STORAGE_DIR=.storage
# (prod con s3) R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_REGION=auto
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Bucket de archivos de la app (privado).
S3_BUCKET=""
# Bucket de BACKUPS: separado, con token propio de solo escritura/lectura para el job.
S3_BACKUP_BUCKET=""
# Dominio público del bucket (solo para archivos marcados públicos; opcional).
S3_PUBLIC_URL=""
# true para MinIO local.
S3_FORCE_PATH_STYLE=false

# --- Backups -----------------------------------------------------------------
# pg_dump / pg_restore de la MISMA versión mayor que el servidor (16).
# PG_DUMP_PATH=/opt/homebrew/opt/postgresql@16/bin/pg_dump
# PG_RESTORE_PATH=/opt/homebrew/opt/postgresql@16/bin/pg_restore

# --- Observabilidad ----------------------------------------------------------
# trace | debug | info | warn | error. En producción los logs salen en JSON.
LOG_LEVEL=info
# Sentry (opcional: vacío = deshabilitado).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Solo en el build, para subir source maps (secreto de CI, nunca NEXT_PUBLIC_).
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Versión que reportan /api/health y Sentry (en Vercel se usa VERCEL_GIT_COMMIT_SHA solo).
APP_VERSION=""
