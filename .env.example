# Conexión a PostgreSQL.
# Local con docker compose (ver docker-compose.yml, puerto host 5433 por defecto):
DATABASE_URL="postgresql://app:app@localhost:5433/gestion?schema=public"
# Externo (Neon/Railway), ejemplo:
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Puerto del host para el contenedor de Postgres (docker compose).
DB_PORT=5433

# Secreto para firmar las sesiones (JWT HS256). Mínimo 32 caracteres.
# Generar uno propio con: openssl rand -base64 32  (en producción, el placeholder es rechazado)
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres"

# Job diario de alertas (/api/cron/alertas): header "Authorization: Bearer <CRON_SECRET>".
# Generar con: openssl rand -hex 32
CRON_SECRET=""
